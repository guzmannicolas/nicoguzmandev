---
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
---

<footer class="bg-secondary border-t border-gray-700 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-lg font-bold text-accent mb-4">NG Dev</h3>
        <p class="text-gray-400 text-sm">
          Transformando negocios con tecnología
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-gray-200 mb-4">
          {lang === 'es' ? 'Enlaces' : 'Links'}
        </h4>
        <ul class="space-y-2 text-sm text-gray-400">
          <li>
            <a href={lang === 'es' ? '/servicios' : '/en/services'} class="hover:text-accent transition-colors">
              {lang === 'es' ? 'Servicios' : 'Services'}
            </a>
          </li>
          <li>
            <a href={lang === 'es' ? '/portafolio' : '/en/portfolio'} class="hover:text-accent transition-colors">
              {lang === 'es' ? 'Portafolio' : 'Portfolio'}
            </a>
          </li>
          <li>
            <a href={lang === 'es' ? '/contacto' : '/en/contact'} class="hover:text-accent transition-colors">
              {lang === 'es' ? 'Contacto' : 'Contact'}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-gray-200 mb-4">
          {lang === 'es' ? 'Redes Sociales' : 'Social Media'}
        </h4>
        <div class="flex space-x-4">
          <a href="#" class="text-gray-400 hover:text-accent transition-colors">LinkedIn</a>
          <a href="#" class="text-gray-400 hover:text-accent transition-colors">GitHub</a>
          <a href="#" class="text-gray-400 hover:text-accent transition-colors">Twitter</a>
        </div>
      </div>
    </div>

    <hr class="border-gray-700 mb-6" />

    <div class="flex justify-between items-center text-sm text-gray-400">
      <p>{t.footer.copyright}</p>
      <a href="#" class="hover:text-accent transition-colors">
        {t.footer.privacy}
      </a>
    </div>
  </div>
</footer>

---
const year = new Date().getFullYear();
---

<footer class="border-t border-[#222220] bg-[#0C0C0B] text-xs">
  <div class="grid grid-cols-1 md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-[#222220]">
    <!-- Column 1: Practice Identity -->
    <div class="md:col-span-4 p-8 md:p-10 flex flex-col justify-between space-y-8">
      <div>
        <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
          ESTUDIO DE INGENIERÍA
        </div>
        <div class="text-lg font-medium tracking-[-0.02em] text-[#EDEDEC] mb-3">
          Nicolás Guzmán
        </div>
        <p class="text-[#9A9994] leading-relaxed text-xs max-w-xs">
          Arquitectura de software comercial, automatización operativa mediante inteligencia artificial y sistemas de gestión para empresas en expansión.
        </p>
      </div>
      <div class="font-mono-tech text-[11px] text-[#5E5D59]">
        BUENOS AIRES, ARGENTINA — DISPONIBLE GLOBALMENTE
      </div>
    </div>

    <!-- Column 2: Divisions -->
    <div class="md:col-span-3 p-8 md:p-10 space-y-4">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase">
        ÁREAS DE PRÁCTICA
      </div>
      <ul class="space-y-3 text-xs">
        <li>
          <a href="/webs" class="flex items-baseline justify-between text-[#9A9994] hover:text-[#EDEDEC] transition-colors py-1 border-b border-[#181816]">
            <span>Presencia Web Comercial</span>
            <span class="font-mono-tech text-[10px] text-[#5E5D59]">01</span>
          </a>
        </li>
        <li>
          <a href="/automatizacion" class="flex items-baseline justify-between text-[#9A9994] hover:text-[#EDEDEC] transition-colors py-1 border-b border-[#181816]">
            <span>Automatización &amp; Agentes IA</span>
            <span class="font-mono-tech text-[10px] text-[#5E5D59]">02</span>
          </a>
        </li>
        <li>
          <a href="/erp" class="flex items-baseline justify-between text-[#9A9994] hover:text-[#EDEDEC] transition-colors py-1 border-b border-[#181816]">
            <span>Consultoría &amp; Sistemas ERP</span>
            <span class="font-mono-tech text-[10px] text-[#5E5D59]">03</span>
          </a>
        </li>
        <li>
          <a href="https://templates.nicoguzmandev.com" target="_blank" rel="noopener noreferrer" class="flex items-baseline justify-between text-[#9A9994] hover:text-[#EDEDEC] transition-colors py-1">
            <span>Catálogo de Demos en Vivo</span>
            <span class="font-mono-tech text-[10px] text-[#5E5D59]">VER</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 3: Live Prototypes -->
    <div class="md:col-span-3 p-8 md:p-10 space-y-4">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase">
        DEMOS SECTORIALES
      </div>
      <ul class="space-y-2.5 text-xs text-[#9A9994]">
        <li>
          <a href="https://templates.nicoguzmandev.com/preview/barbershop" target="_blank" rel="noopener noreferrer" class="hover:text-[#EDEDEC] transition-colors block">
            I. Barbería &amp; Cuidado Personal
          </a>
        </li>
        <li>
          <a href="https://templates.nicoguzmandev.com/preview/restaurant" target="_blank" rel="noopener noreferrer" class="hover:text-[#EDEDEC] transition-colors block">
            II. Gastronomía &amp; Alta Cocina
          </a>
        </li>
        <li>
          <a href="https://templates.nicoguzmandev.com/preview/hardware-store" target="_blank" rel="noopener noreferrer" class="hover:text-[#EDEDEC] transition-colors block">
            III. Ferretería &amp; Suministros
          </a>
        </li>
        <li>
          <a href="https://templates.nicoguzmandev.com/preview/real-estate" target="_blank" rel="noopener noreferrer" class="hover:text-[#EDEDEC] transition-colors block">
            IV. Desarrollos Inmobiliarios
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 4: Direct Contact -->
    <div class="md:col-span-2 p-8 md:p-10 flex flex-col justify-between space-y-6">
      <div class="space-y-3">
        <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase">
          CONTACTO DIRECTO
        </div>
        <p class="text-xs text-[#9A9994] leading-relaxed">
          Relevamiento técnico y cotización directa sin intermediarios comerciales.
        </p>
      </div>
      <div class="space-y-2">
        <a
          href="https://wa.me/5491100000000?text=Hola%20Nicol%C3%A1s.%20Me%20contacto%20desde%20nicoguzmandev.com%20para%20evaluar%20un%20proyecto."
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full py-3 px-4 text-center text-xs font-medium border border-[#363632] text-[#EDEDEC] hover:bg-[#EDEDEC] hover:text-[#0C0C0B] transition-colors"
        >
          WHATSAPP EJECUTIVO
        </a>
        <a
          href="/contacto"
          class="block w-full py-2.5 px-4 text-center font-mono-tech text-[10px] text-[#9A9994] hover:text-[#EDEDEC] transition-colors"
        >
          FORMULARIO TÉCNICO
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="border-t border-[#222220] px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono-tech text-[11px] text-[#5E5D59]">
    <div>
      © {year} NICOLÁS GUZMÁN. TODOS LOS DERECHOS RESERVADOS.
    </div>
    <div class="flex items-center gap-6">
      <a href="https://github.com/guzmannicolas" target="_blank" rel="noopener noreferrer" class="hover:text-[#EDEDEC] transition-colors">
        GITHUB
      </a>
      <a href="https://templates.nicoguzmandev.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#EDEDEC] transition-colors">
        SHOWROOM
      </a>
      <a href="/contacto" class="hover:text-[#EDEDEC] transition-colors">
        CONTACTO
      </a>
    </div>
  </div>
</footer>

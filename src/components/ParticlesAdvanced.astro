---
// Advanced particles component with hexagon path, emitters, and custom configuration
// This component supports custom props for full customization
export interface Props {
  particleColor?: string;
  particleCount?: number;
  emitterCount?: number;
  enableInteractivity?: boolean;
}

const {
  particleColor = '#3b82f6',
  particleCount = 60,
  emitterCount = 3,
  enableInteractivity = true,
} = Astro.props;
---

<div
  id="particles-advanced-container"
  data-particle-color={particleColor}
  data-particle-count={particleCount}
  data-emitter-count={emitterCount}
  data-enable-interactivity={enableInteractivity}
  style="
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  "
></div>

<script>
  import { tsParticles } from 'tsparticles-engine';
  import { loadSlim } from 'tsparticles-slim';

  // Initialize advanced particles with custom configuration
  if (!window.particlesAdvancedInitialized) {
    window.particlesAdvancedInitialized = true;

    await loadSlim(tsParticles);

    const container = document.getElementById('particles-advanced-container');

    if (container) {
      const particleColor = container.dataset.particleColor || '#3b82f6';
      const particleCount = parseInt(container.dataset.particleCount || '60');
      const emitterCount = parseInt(container.dataset.emitterCount || '3');
      const enableInteractivity = container.dataset.enableInteractivity === 'true';

      // Calculate hexagon vertices for emitter positioning
      const getHexagonPoints = (centerX: number, centerY: number, radius: number) => {
        const points = [];
        for (let i = 0; i < 6; i++) {
          const angle = (i * Math.PI) / 3;
          points.push({
            x: centerX + radius * Math.cos(angle),
            y: centerY + radius * Math.sin(angle),
          });
        }
        return points;
      };

      const centerX = typeof window !== 'undefined' ? window.innerWidth / 2 : 960;
      const centerY = typeof window !== 'undefined' ? window.innerHeight / 2 : 540;
      const hexRadius = 150;
      const hexPoints = getHexagonPoints(centerX, centerY, hexRadius);

      const particlesConfig = {
        particles: {
          number: {
            value: particleCount,
            density: {
              enable: true,
              value_area: 1200,
            },
          },
          color: {
            value: particleColor,
          },
          shape: {
            type: 'circle',
          },
          opacity: {
            value: {
              min: 0.3,
              max: 0.7,
            },
            random: {
              enable: true,
              minimumValue: 0.2,
            },
            animation: {
              enable: true,
              speed: 0.8,
              minimumValue: 0.1,
              sync: false,
            },
          },
          size: {
            value: {
              min: 1.5,
              max: 4,
            },
            random: {
              enable: true,
              minimumValue: 1,
            },
          },
          move: {
            enable: true,
            speed: {
              min: 1,
              max: 3,
            },
            direction: 'none',
            random: true,
            straight: false,
            outModes: {
              default: 'bounce',
            },
            attract: {
              enable: true,
              rotateX: 300,
              rotateY: 300,
            },
          },
          life: {
            count: 0,
            duration: {
              sync: false,
              value: 0,
            },
          },
        },
        interactivity: {
          events: {
            onHover: {
              enable: enableInteractivity,
              mode: 'repulse',
            },
            onClick: {
              enable: enableInteractivity,
              mode: 'push',
            },
          },
          modes: {
            repulse: {
              distance: 150,
              duration: 0.4,
            },
            push: {
              quantity: 3,
            },
          },
        },
        emitters: Array.from({ length: emitterCount }).map((_, index) => {
          const point = hexPoints[index % 6];
          return {
            position: {
              x: point.x,
              y: point.y,
            },
            rate: {
              delay: 0,
              quantity: 2,
            },
            life: {
              count: 0,
              duration: 0,
            },
          };
        }),
        background: {
          color: 'transparent',
        },
      };

      await tsParticles.load('particles-advanced-container', particlesConfig);
    }
  }
</script>

---
// Simple animated circuit background
---

<div style="
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
">
  <svg
    style="
      width: 100%;
      height: 100%;
      display: block;
    "
    viewBox="0 0 1920 1080"
    preserveAspectRatio="xMidYMid slice"
  >
    <defs>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="coloredBlur" />
        <feMerge>
          <feMergeNode in="coloredBlur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Background grid -->
    <g opacity="0.3">
      <line x1="0" y1="0" x2="1920" y2="0" stroke="#3b82f6" stroke-width="1" />
      <line x1="0" y1="100" x2="1920" y2="100" stroke="#3b82f6" stroke-width="0.5" />
      <line x1="0" y1="200" x2="1920" y2="200" stroke="#3b82f6" stroke-width="0.5" />
      <line x1="0" y1="300" x2="1920" y2="300" stroke="#3b82f6" stroke-width="0.5" />
      <line x1="0" y1="400" x2="1920" y2="400" stroke="#3b82f6" stroke-width="1" />
      <line x1="0" y1="500" x2="1920" y2="500" stroke="#3b82f6" stroke-width="0.5" />
      <line x1="0" y1="600" x2="1920" y2="600" stroke="#3b82f6" stroke-width="0.5" />
      <line x1="0" y1="700" x2="1920" y2="700" stroke="#3b82f6" stroke-width="0.5" />
      <line x1="0" y1="800" x2="1920" y2="800" stroke="#3b82f6" stroke-width="1" />
      <line x1="0" y1="900" x2="1920" y2="900" stroke="#3b82f6" stroke-width="0.5" />
    </g>

    <!-- Animated circuit paths -->
    <g filter="url(#glow)" class="circuit-group-1">
      <path
        d="M 200,300 L 400,350 L 600,300 L 800,400 L 1000,350 L 1200,450"
        stroke="#3b82f6"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      />
    </g>

    <g filter="url(#glow)" class="circuit-group-2">
      <path
        d="M 300,500 L 500,550 L 700,500 L 900,600 L 1100,550"
        stroke="#8b5cf6"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      />
    </g>

    <g filter="url(#glow)" class="circuit-group-3">
      <path
        d="M 100,700 L 300,750 L 500,700 L 700,800 L 900,750 L 1100,850"
        stroke="#3b82f6"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      />
    </g>

    <!-- Pulsing nodes -->
    <circle cx="400" cy="350" r="4" fill="#3b82f6" class="node-pulse" />
    <circle cx="600" cy="300" r="4" fill="#3b82f6" class="node-pulse" style="animation-delay: 0.3s" />
    <circle cx="800" cy="400" r="4" fill="#3b82f6" class="node-pulse" style="animation-delay: 0.6s" />
    <circle cx="500" cy="550" r="4" fill="#8b5cf6" class="node-pulse" style="animation-delay: 0.9s" />
    <circle cx="700" cy="500" r="4" fill="#8b5cf6" class="node-pulse" style="animation-delay: 1.2s" />
  </svg>
</div>

<style>
  .circuit-group-1 {
    animation: flow1 6s ease-in-out infinite;
  }

  .circuit-group-2 {
    animation: flow2 8s ease-in-out infinite 1s;
  }

  .circuit-group-3 {
    animation: flow3 7s ease-in-out infinite 2s;
  }

  .node-pulse {
    animation: pulse 3s ease-in-out infinite;
  }

  @keyframes flow1 {
    0% {
      opacity: 0.3;
      filter: drop-shadow(0 0 2px rgba(59, 130, 246, 0.3));
    }
    50% {
      opacity: 1;
      filter: drop-shadow(0 0 12px rgba(59, 130, 246, 0.9));
    }
    100% {
      opacity: 0.3;
      filter: drop-shadow(0 0 2px rgba(59, 130, 246, 0.3));
    }
  }

  @keyframes flow2 {
    0% {
      opacity: 0.3;
      filter: drop-shadow(0 0 2px rgba(139, 92, 246, 0.3));
    }
    50% {
      opacity: 1;
      filter: drop-shadow(0 0 10px rgba(139, 92, 246, 0.8));
    }
    100% {
      opacity: 0.3;
      filter: drop-shadow(0 0 2px rgba(139, 92, 246, 0.3));
    }
  }

  @keyframes flow3 {
    0% {
      opacity: 0.3;
      filter: drop-shadow(0 0 2px rgba(59, 130, 246, 0.3));
    }
    50% {
      opacity: 1;
      filter: drop-shadow(0 0 11px rgba(59, 130, 246, 0.85));
    }
    100% {
      opacity: 0.3;
      filter: drop-shadow(0 0 2px rgba(59, 130, 246, 0.3));
    }
  }

  @keyframes pulse {
    0%,
    100% {
      r: 3;
      opacity: 0.5;
      filter: drop-shadow(0 0 2px currentColor);
    }
    50% {
      r: 6;
      opacity: 1;
      filter: drop-shadow(0 0 8px currentColor);
    }
  }
</style>

---
import Icon from './Icon.astro';

interface Props {
  iconType: 'design' | 'development' | 'automation' | 'erp';
  title: string;
  description: string;
}

const { iconType, title, description } = Astro.props;
---

<div class="reveal bg-secondary border border-gray-700 rounded-lg p-6 hover:border-accent transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">
  <div class="mb-4">
    <Icon icon={iconType} />
  </div>
  <h3 class="text-xl font-semibold text-accent mb-2">{title}</h3>
  <p class="text-gray-400 text-sm leading-relaxed">{description}</p>
</div>

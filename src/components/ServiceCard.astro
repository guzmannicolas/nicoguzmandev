---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="bg-secondary border border-gray-700 rounded-lg p-6 hover:border-accent transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="text-xl font-semibold text-accent mb-2">{title}</h3>
  <p class="text-gray-400 text-sm leading-relaxed">{description}</p>
</div>

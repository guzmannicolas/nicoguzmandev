---
import es from '../i18n/es.json';
import en from '../i18n/en.json';
import Icon from './Icon.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
const otherLang = lang === 'es' ? 'en' : 'es';
const baseUrl = lang === 'es' ? '' : '/en';

const navLinks = [
  { label: t.nav.inicio, href: `${baseUrl}/` },
  { label: t.nav.servicios, href: `${baseUrl}/${lang === 'es' ? 'servicios' : 'services'}` },
  { label: t.nav.portafolio, href: `${baseUrl}/${lang === 'es' ? 'portafolio' : 'portfolio'}` },
  { label: lang === 'es' ? 'Precios' : 'Pricing', href: `${baseUrl}/${lang === 'es' ? 'precios' : 'pricing'}` },
  { label: lang === 'es' ? 'Testimonios' : 'Testimonials', href: `${baseUrl}/${lang === 'es' ? 'testimonios' : 'testimonials'}` },
];
---

<nav id="navbar" class="bg-gradient-to-r from-secondary/90 via-secondary/85 to-secondary/90 backdrop-blur-md border-b border-accent/20 sticky top-0 z-50 transition-all duration-300 shadow-lg shadow-accent/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo with glow -->
      <div class="flex-shrink-0 group">
        <a href={`${baseUrl}/`} class="flex items-center gap-2 relative">
          <div class="absolute inset-0 bg-accent/20 rounded-lg blur-lg group-hover:bg-accent/40 transition-all duration-300 -z-10"></div>
          <img src="/logo.png" alt="NG Dev" class="h-14 w-auto transition-transform duration-300 group-hover:scale-110 drop-shadow-lg" />
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-1 flex-1 justify-center mx-12">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link relative px-4 py-2 text-gray-300 text-sm font-medium transition-all duration-300 hover:text-white group"
          >
            <span class="relative z-10">{link.label}</span>
            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-accent via-blue-400 to-accent group-hover:w-full transition-all duration-300 rounded-full"></div>
            <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/5 rounded transition-all duration-300"></div>
          </a>
        ))}
      </div>

      <!-- Right Section -->
      <div class="flex items-center space-x-3">
        <!-- Language Toggle -->
        <a
          href={lang === 'es' ? '/en/' : '/'}
          class="text-xs font-semibold text-gray-400 hover:text-accent transition-all duration-300 uppercase px-3 py-2 rounded hover:bg-accent/10 hidden sm:block"
        >
          {otherLang}
        </a>

        <!-- Contact Button (Desktop) -->
        <a
          href={`${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}`}
          class="hidden sm:block relative group px-6 py-2.5 text-sm font-semibold overflow-hidden rounded-lg transition-all duration-300"
        >
          <div class="absolute inset-0 bg-gradient-to-r from-accent to-blue-500 transition-all duration-300"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-accent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
          <span class="relative text-white flex items-center gap-2">
            {t.nav.contacto}
            <span class="group-hover:translate-x-1 transition-transform duration-300">
              <Icon icon="arrow" class="w-4 h-4" />
            </span>
          </span>
        </a>

        <!-- Mobile Menu Button (hamburger -> X) -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2.5 rounded-lg hover:bg-accent/20 transition-all duration-300 relative z-50"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span class="hamburger-box">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu - Fullscreen overlay -->
  <div
    id="mobile-menu"
    class="mobile-menu md:hidden fixed inset-0 z-40 bg-gradient-to-b from-secondary via-primary to-secondary"
  >
    <div class="flex flex-col h-full pt-24 px-6 pb-8 overflow-y-auto">
      <div class="flex-1 space-y-2">
        {navLinks.map((link, idx) => (
          <a
            href={link.href}
            class="menu-item flex items-center gap-3 px-6 py-4 text-2xl font-semibold text-gray-200 hover:text-white hover:bg-accent/10 rounded-xl transition-all duration-300 border-l-4 border-transparent hover:border-accent"
            style={`--i: ${idx}`}
          >
            <span class="text-accent"><Icon icon="arrow" class="w-5 h-5" /></span>
            {link.label}
          </a>
        ))}
      </div>

      <div class="space-y-4 pt-6 border-t border-accent/20">
        <a
          href={lang === 'es' ? '/en/' : '/'}
          class="block text-center text-sm font-semibold text-gray-400 hover:text-accent transition-all duration-300 uppercase px-4 py-3 rounded-lg hover:bg-accent/10"
        >
          {lang === 'es' ? 'English' : 'Español'}
        </a>
        <a
          href={`${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}`}
          class="flex items-center justify-center gap-2 w-full text-center bg-gradient-to-r from-accent to-blue-500 text-white px-6 py-4 rounded-xl text-lg font-semibold hover:shadow-lg hover:shadow-accent/50 transition-all duration-300"
        >
          {t.nav.contacto}
          <Icon icon="arrow" class="w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Hamburger icon */
  .hamburger-box {
    display: block;
    position: relative;
    width: 24px;
    height: 18px;
  }
  .hamburger-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: #d1d5db;
    transition: transform 0.3s ease, opacity 0.2s ease, background 0.3s ease;
  }
  .hamburger-line:nth-child(1) { top: 0; }
  .hamburger-line:nth-child(2) { top: 8px; }
  .hamburger-line:nth-child(3) { top: 16px; }

  /* Animate to X when open */
  .menu-open .hamburger-line { background: #3b82f6; }
  .menu-open .hamburger-line:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-open .hamburger-line:nth-child(2) { opacity: 0; }
  .menu-open .hamburger-line:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* Fullscreen mobile menu */
  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }
  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Staggered link entrance */
  .mobile-menu .menu-item {
    opacity: 0;
    transform: translateX(-24px);
  }
  .mobile-menu.open .menu-item {
    animation: menu-item-in 0.4s ease forwards;
    animation-delay: calc(var(--i) * 60ms + 100ms);
  }
  @keyframes menu-item-in {
    to { opacity: 1; transform: translateX(0); }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  const setMenu = (open: boolean) => {
    if (!menu || !btn) return;
    menu.classList.toggle('open', open);
    btn.classList.toggle('menu-open', open);
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => {
    setMenu(!menu?.classList.contains('open'));
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Navbar scroll effect
  window.addEventListener(
    'scroll',
    () => {
      if (!navbar) return;
      if (window.scrollY > 50) {
        navbar.classList.add('bg-secondary/95', 'shadow-xl', 'shadow-accent/20');
        navbar.classList.remove('shadow-lg', 'shadow-accent/10');
      } else {
        navbar.classList.remove('bg-secondary/95', 'shadow-xl', 'shadow-accent/20');
        navbar.classList.add('shadow-lg', 'shadow-accent/10');
      }
    },
    { passive: true }
  );
</script>

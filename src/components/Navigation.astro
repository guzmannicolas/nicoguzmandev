---
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
const otherLang = lang === 'es' ? 'en' : 'es';
const baseUrl = lang === 'es' ? '' : '/en';

const navLinks = [
  { label: t.nav.inicio, href: `${baseUrl}/` },
  { label: t.nav.servicios, href: `${baseUrl}/${lang === 'es' ? 'servicios' : 'services'}` },
  { label: t.nav.portafolio, href: `${baseUrl}/${lang === 'es' ? 'portafolio' : 'portfolio'}` },
  { label: lang === 'es' ? 'Precios' : 'Pricing', href: `${baseUrl}/${lang === 'es' ? 'precios' : 'pricing'}` },
  { label: lang === 'es' ? 'Testimonios' : 'Testimonials', href: `${baseUrl}/${lang === 'es' ? 'testimonios' : 'testimonials'}` },
];
---

<nav id="navbar" class="bg-gradient-to-r from-secondary/90 via-secondary/85 to-secondary/90 backdrop-blur-md border-b border-accent/20 sticky top-0 z-50 transition-all duration-300 shadow-lg shadow-accent/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo with glow -->
      <div class="flex-shrink-0 group">
        <a href={`${baseUrl}/`} class="flex items-center gap-2 relative">
          <div class="absolute inset-0 bg-accent/20 rounded-lg blur-lg group-hover:bg-accent/40 transition-all duration-300 -z-10"></div>
          <img src="/logo.png" alt="NG Dev" class="h-14 w-auto transition-transform duration-300 group-hover:scale-110 drop-shadow-lg" />
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-1 flex-1 justify-center mx-12">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link relative px-4 py-2 text-gray-300 text-sm font-medium transition-all duration-300 hover:text-white group"
          >
            <span class="relative z-10">{link.label}</span>
            <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-accent via-blue-400 to-accent group-hover:w-full transition-all duration-300 rounded-full"></div>
            <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/5 rounded transition-all duration-300"></div>
          </a>
        ))}
      </div>

      <!-- Right Section -->
      <div class="flex items-center space-x-3">
        <!-- Language Toggle -->
        <a
          href={lang === 'es' ? '/en/' : '/'}
          class="text-xs font-semibold text-gray-400 hover:text-accent transition-all duration-300 uppercase px-3 py-2 rounded hover:bg-accent/10 hidden sm:block"
        >
          {otherLang}
        </a>

        <!-- Contact Button (Desktop) -->
        <a
          href={`${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}`}
          class="hidden sm:block relative group px-6 py-2.5 text-sm font-semibold overflow-hidden rounded-lg transition-all duration-300"
        >
          <div class="absolute inset-0 bg-gradient-to-r from-accent to-blue-500 transition-all duration-300"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-accent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
          <span class="relative text-white flex items-center gap-2">
            {t.nav.contacto}
            <span class="group-hover:translate-x-1 transition-transform duration-300">→</span>
          </span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2.5 rounded-lg hover:bg-accent/20 transition-all duration-300 relative group"
          aria-label="Toggle menu"
        >
          <div class="absolute inset-0 bg-accent/0 group-hover:bg-accent/10 rounded-lg transition-all duration-300"></div>
          <svg class="w-6 h-6 text-gray-300 relative z-10 transition-colors duration-300 group-hover:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu - Fullscreen -->
  <div id="mobile-menu" class="hidden fixed inset-0 top-20 md:hidden bg-gradient-to-b from-secondary via-primary to-secondary z-40 overflow-y-auto animate-slide-in">
    <div class="px-4 py-6 space-y-1">
      {navLinks.map((link, idx) => (
        <a
          href={link.href}
          class="block px-6 py-4 text-lg text-gray-300 hover:text-white hover:bg-accent/10 rounded-lg transition-all duration-300 border-l-4 border-transparent hover:border-accent transform hover:translate-x-1 animate-fade-in"
          style={`animation-delay: ${idx * 50}ms`}
        >
          {link.label}
        </a>
      ))}

      <div class="px-6 py-6 border-t border-accent/20 mt-6 space-y-4 animate-fade-in" style="animation-delay: 250ms">
        <a
          href={lang === 'es' ? '/en/' : '/'}
          class="block text-sm font-semibold text-gray-400 hover:text-accent transition-all duration-300 uppercase px-4 py-3 rounded hover:bg-accent/10"
        >
          {lang === 'es' ? 'English' : 'Español'}
        </a>
        <a
          href={`${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}`}
          class="block w-full text-center bg-gradient-to-r from-accent to-blue-500 text-white px-6 py-4 rounded-lg text-lg font-semibold hover:shadow-lg hover:shadow-accent/50 transition-all duration-300"
        >
          {t.nav.contacto}
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-link {
    position: relative;
  }

  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-slide-in {
    animation: slide-in 0.3s ease-out;
  }

  .animate-fade-in {
    animation: fade-in 0.4s ease-out forwards;
    opacity: 0;
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll animation
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-secondary/95', 'backdrop-blur-lg', 'shadow-xl', 'shadow-accent/20');
      navbar?.classList.remove('bg-gradient-to-r', 'from-secondary/90', 'via-secondary/85', 'to-secondary/90', 'shadow-lg', 'shadow-accent/10');
    } else {
      navbar?.classList.remove('bg-secondary/95', 'backdrop-blur-lg', 'shadow-xl', 'shadow-accent/20');
      navbar?.classList.add('bg-gradient-to-r', 'from-secondary/90', 'via-secondary/85', 'to-secondary/90', 'shadow-lg', 'shadow-accent/10');
    }
  });

  mobileMenuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu?.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  });

  // Close menu on link click
  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      document.body.style.overflow = 'auto';
    });
  });
</script>

---
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
const otherLang = lang === 'es' ? 'en' : 'es';
const baseUrl = lang === 'es' ? '' : '/en';

const navLinks = [
  { label: t.nav.inicio, href: `${baseUrl}/` },
  { label: t.nav.servicios, href: `${baseUrl}/${lang === 'es' ? 'servicios' : 'services'}` },
  { label: t.nav.portafolio, href: `${baseUrl}/${lang === 'es' ? 'portafolio' : 'portfolio'}` },
  { label: lang === 'es' ? 'Precios' : 'Pricing', href: `${baseUrl}/${lang === 'es' ? 'precios' : 'pricing'}` },
  { label: lang === 'es' ? 'Testimonios' : 'Testimonials', href: `${baseUrl}/${lang === 'es' ? 'testimonios' : 'testimonials'}` },
];
---

<nav id="navbar" class="bg-secondary/80 backdrop-blur-sm border-b border-gray-700 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href={`${baseUrl}/`} class="flex items-center gap-2">
          <img src="/logo.png" alt="NG Dev" class="h-10 w-auto" />
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-6 flex-1 justify-center mx-12">
        {navLinks.map((link) => (
          <a href={link.href} class="text-gray-300 hover:text-accent transition-colors text-sm">
            {link.label}
          </a>
        ))}
      </div>

      <!-- Right Section -->
      <div class="flex items-center space-x-3">
        <!-- Language Toggle -->
        <a
          href={lang === 'es' ? '/en/' : '/'}
          class="text-xs font-semibold text-gray-400 hover:text-accent transition-colors uppercase hidden sm:block"
        >
          {otherLang}
        </a>

        <!-- Contact Button (Desktop) -->
        <a
          href={`${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}`}
          class="bg-accent text-white px-4 py-2 rounded text-sm hover:bg-blue-600 transition-colors hidden sm:block"
        >
          {t.nav.contacto}
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded hover:bg-gray-700 transition-colors"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-700 py-4 space-y-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-2 text-gray-300 hover:text-accent hover:bg-gray-800/50 rounded transition-colors"
        >
          {link.label}
        </a>
      ))}

      <div class="px-4 py-2 border-t border-gray-700 mt-4 space-y-3">
        <a
          href={lang === 'es' ? '/en/' : '/'}
          class="block text-xs font-semibold text-gray-400 hover:text-accent transition-colors uppercase"
        >
          {lang === 'es' ? 'English' : 'Español'}
        </a>
        <a
          href={`${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}`}
          class="block w-full text-center bg-accent text-white px-4 py-2 rounded text-sm hover:bg-blue-600 transition-colors"
        >
          {t.nav.contacto}
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll animation
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('bg-secondary/95', 'backdrop-blur-md', 'shadow-lg');
      navbar?.classList.remove('bg-secondary/80');
    } else {
      navbar?.classList.remove('bg-secondary/95', 'backdrop-blur-md', 'shadow-lg');
      navbar?.classList.add('bg-secondary/80');
    }
  });

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close menu on link click
  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>

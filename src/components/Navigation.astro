---
import es from '../i18n/es.json';
import en from '../i18n/en.json';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'es' ? es : en;
const otherLang = lang === 'es' ? 'en' : 'es';
const baseUrl = lang === 'es' ? '' : '/en';

const navLinks = [
  { label: t.nav.inicio, href: `${baseUrl}/` },
  { label: t.nav.servicios, href: `${baseUrl}/${lang === 'es' ? 'servicios' : 'services'}` },
  { label: t.nav.portafolio, href: `${baseUrl}/${lang === 'es' ? 'portafolio' : 'portfolio'}` },
  { label: t.nav.contacto, href: `${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}` },
];
---

<nav class="bg-secondary border-b border-gray-700 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0">
        <a href={`${baseUrl}/`} class="text-xl font-bold text-accent">
          NG Dev
        </a>
      </div>

      <div class="hidden md:flex space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-gray-300 hover:text-accent transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center space-x-4">
        <a
          href={lang === 'es' ? '/en/' : '/'}
          class="text-xs font-semibold text-gray-400 hover:text-accent transition-colors uppercase"
        >
          {otherLang}
        </a>
        <a
          href={`${baseUrl}/${lang === 'es' ? 'contacto' : 'contact'}`}
          class="bg-accent text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors"
        >
          {t.nav.contacto}
        </a>
      </div>
    </div>
  </div>
</nav>

---
// Particles background with proper styling
---

<div id="tsparticles" style="
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
"></div>

<script>
  import { tsParticles } from "tsparticles-engine";
  import { loadSlim } from "tsparticles-slim";

  const config = {
    fullScreen: {
      enable: true,
      zIndex: 0
    },
    particles: {
      color: {
        value: "#3b82f6"
      },
      move: {
        enable: true,
        speed: 2
      },
      number: {
        value: 80
      },
      opacity: {
        value: 0.5
      },
      shape: {
        type: "circle"
      },
      size: {
        value: { min: 1, max: 3 }
      },
      links: {
        color: "#3b82f6",
        distance: 150,
        enable: true,
        opacity: 0.5,
        width: 1
      }
    },
    interactivity: {
      events: {
        onClick: {
          enable: true,
          mode: "push"
        },
        onHover: {
          enable: true,
          mode: "repulse"
        }
      },
      modes: {
        push: {
          quantity: 4
        },
        repulse: {
          distance: 200,
          duration: 0.4
        }
      }
    },
    detectRetina: true
  };

  (async () => {
    await loadSlim(tsParticles);
    await tsParticles.load("tsparticles", config);
  })();
</script>

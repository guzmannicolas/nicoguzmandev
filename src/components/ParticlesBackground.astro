---
// Particles background with hexagon path
---

<div id="tsparticles"></div>

<script>
  import { tsParticles } from "tsparticles-engine";
  import { loadSlim } from "tsparticles-slim";

  (async () => {
    try {
      await loadSlim(tsParticles);

      await tsParticles.load("tsparticles", {
        particles: {
          paint: {
            fill: {
              color: {
                value: "#3b82f6",
                animation: {
                  enable: true,
                  speed: 10
                }
              },
              enable: true
            }
          },
          move: {
            direction: "none",
            enable: true,
            outModes: {
              default: "destroy"
            },
            path: {
              clamp: false,
              enable: true,
              delay: {
                value: 0
              },
              generator: "polygonPathGenerator",
              options: {
                sides: 6,
                turnSteps: 30,
                angle: 30
              }
            },
            speed: 3
          },
          number: {
            density: {
              enable: true
            },
            value: 0
          },
          opacity: {
            value: 0.8
          },
          shape: {
            type: "circle"
          },
          size: {
            value: 3
          }
        },
        background: {
          color: "transparent"
        },
        emitters: {
          direction: "none",
          rate: {
            quantity: 1,
            delay: 0.25
          },
          size: {
            width: 0,
            height: 0
          },
          position: {
            x: 50,
            y: 50
          }
        },
        trail: {
          fill: {
            color: "#3b82f6"
          },
          length: 20,
          enable: true
        }
      });
    } catch (error) {
      console.error("Error loading particles:", error);
    }
  })();
</script>

<style>
  #tsparticles {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

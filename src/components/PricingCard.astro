---
import Icon from './Icon.astro';

interface Plan {
  name: string;
  price: string;
  description: string;
  features: string[];
  highlighted: boolean;
}

interface Props {
  service: string;
  iconType: 'design' | 'development' | 'automation' | 'erp';
  plan: Plan;
  contactLabel: string;
}

const { service, iconType, plan, contactLabel } = Astro.props;
---

<div class={`reveal relative flex flex-col rounded-xl p-6 border transition-all duration-300 ${
  plan.highlighted
    ? 'border-accent bg-accent/10 shadow-lg shadow-accent/20 scale-105'
    : 'border-gray-700 bg-secondary hover:border-accent/50'
}`}>
  {plan.highlighted && (
    <div class="absolute -top-3 left-1/2 -translate-x-1/2">
      <span class="bg-accent text-white text-xs font-bold px-4 py-1 rounded-full">
        Popular
      </span>
    </div>
  )}

  <div class="mb-4">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-accent"><Icon icon={iconType} class="w-5 h-5" /></span>
      <p class="text-gray-400 text-xs">{service}</p>
    </div>
    <h3 class="text-xl font-bold text-white">{plan.name}</h3>
    <p class="text-3xl font-bold text-accent mt-2">{plan.price}</p>
    <p class="text-gray-400 text-sm mt-1">{plan.description}</p>
  </div>

  <ul class="space-y-2 flex-1 mb-6">
    {plan.features.map((feature) => (
      <li class="flex items-start gap-2 text-sm text-gray-300">
        <span class="text-accent mt-0.5 flex-shrink-0"><Icon icon="check" class="w-4 h-4" /></span>
        {feature}
      </li>
    ))}
  </ul>

  <a
    href="#contact"
    class={`text-center py-2.5 px-4 rounded-lg font-semibold text-sm transition-colors ${
      plan.highlighted
        ? 'bg-accent text-white hover:bg-blue-600'
        : 'border border-accent text-accent hover:bg-accent hover:text-white'
    }`}
  >
    {contactLabel}
  </a>
</div>

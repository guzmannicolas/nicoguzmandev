---
// Particles component with emitters (particles spawning from specific locations)
// Perfect for creating effects from specific UI elements
---

<div id="tsparticles"></div>

<script>
  import { tsParticles } from "tsparticles-engine";
  import { loadSlim } from "tsparticles-slim";

  (async () => {
    try {
      await loadSlim(tsParticles);

      await tsParticles.load("tsparticles", {
        particles: {
          number: {
            value: 0, // Particles spawn from emitters, not initially
          },
          color: {
            value: "#ffffff",
          },
          shape: {
            type: "polygon",
            polygon: {
              sides: 6,
            },
          },
          opacity: {
            value: 0.7,
            animation: {
              enable: true,
              minimumValue: 0,
              speed: 0.5,
              startValue: "max",
              destroy: "min",
            },
          },
          size: {
            value: 2,
            random: {
              enable: true,
              minimumValue: 1,
            },
          },
          move: {
            enable: true,
            speed: 1,
            direction: "top",
            outModes: {
              default: "out",
            },
          },
          life: {
            duration: {
              sync: false,
              value: 3,
            },
          },
        },
        emitters: [
          {
            // Emitter at top center - streaming upward
            position: {
              x: 50,
              y: 0,
            },
            rate: {
              delay: 0.25,
              quantity: 2,
            },
            shape: "polygon",
            direction: "top",
            size: {
              mode: "percent",
              height: 0,
              width: 100,
            },
          },
          {
            // Emitter at bottom center - streaming downward
            position: {
              x: 50,
              y: 100,
            },
            rate: {
              delay: 0.25,
              quantity: 2,
            },
            shape: "polygon",
            direction: "bottom",
            size: {
              mode: "percent",
              height: 0,
              width: 100,
            },
          },
        ],
        interactivity: {
          events: {
            onHover: {
              enable: true,
              mode: "repulse",
            },
            onClick: {
              enable: true,
              mode: "push",
            },
          },
          modes: {
            repulse: {
              distance: 200,
              duration: 0.4,
            },
            push: {
              quantity: 8,
            },
          },
        },
        background: {
          color: "transparent",
        },
        fullScreen: {
          enable: true,
          zIndex: -1,
        },
        detectRetina: true,
      });
    } catch (error) {
      console.error("Error loading particles with emitters:", error);
    }
  })();
</script>

<style>
  #tsparticles {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }
</style>

---
const TEMPLATES = [
  {
    index: '01',
    name: 'BARBERÍA & SALÓN DE AUTOR',
    rubro: 'ESTÉTICA & GROOMING',
    estructura: 'MULTIPÁGINA (4 VISTAS)',
    desc: 'Cortes, lista de precios actualizada, galería de trabajos y reserva directa por WhatsApp.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/barbershop'
  },
  {
    index: '02',
    name: 'RESTAURANTE & BISTRÓ',
    rubro: 'GASTRONOMÍA & BARES',
    estructura: 'MULTIPÁGINA (3 VISTAS)',
    desc: 'Carta digital dividida por entradas, platos principales y bebidas, fotos de salón y reserva de mesas.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/restaurant'
  },
  {
    index: '03',
    name: 'CAFETERÍA DE ESPECIALIDAD',
    rubro: 'CAFÉ & PASTELERÍA',
    estructura: 'MULTIPÁGINA (4 VISTAS)',
    desc: 'Menú de cafetería y pastelería, historia del tostado, horarios y mapa de sucursales.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/coffee-shop'
  },
  {
    index: '04',
    name: 'FERRETERÍA INDUSTRIAL & CORRALÓN',
    rubro: 'HERRAMIENTAS & INSUMOS',
    estructura: 'MULTIPÁGINA (4 VISTAS)',
    desc: 'Catálogo de rubros industriales, marcas trabajadas y pedido de cotización para gremio o particulares.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/hardware-store'
  },
  {
    index: '05',
    name: 'TALLER MECÁNICO & DIAGNÓSTICO',
    rubro: 'SERVICIO AUTOMOTRIZ',
    estructura: 'MULTIPÁGINA (4 VISTAS)',
    desc: 'Servicios de mantenimiento, diagnóstico computarizado, solicitud de presupuesto y turnos de taller.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/auto-repair'
  },
  {
    index: '06',
    name: 'INMOBILIARIA & DESARROLLOS',
    rubro: 'PROPIEDADES & ALQUILERES',
    estructura: 'LANDING PAGE EJECUTIVA',
    desc: 'Unidades destacadas en venta y alquiler, tasaciones y contacto directo con corredores inmobiliarios.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/real-estate'
  },
  {
    index: '07',
    name: 'ESTUDIO DE FOTOGRAFÍA & PRODUCTORA',
    rubro: 'IMAGEN & AUDIOVISUAL',
    estructura: 'LANDING PAGE EDITORIAL',
    desc: 'Porfolio fotográfico a pantalla completa, packs de sesiones comerciales y agenda de fechas.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/photography'
  },
  {
    index: '08',
    name: 'ESTUDIO DE TATUAJES & ARTE',
    rubro: 'TATTOO STUDIO',
    estructura: 'LANDING PAGE DE AUTOR',
    desc: 'Trabajos por artista, estilos disponibles, cuidados post-sesión y cotizador rápido por WhatsApp.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/tattoo'
  }
];
---

<div class="w-full border-2 border-[#0A0A0A] bg-white">
  <!-- Header Banner -->
  <div class="p-8 md:p-12 border-b-2 border-[#0A0A0A] bg-[#0A0A0A] text-white flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-[#002FA7] bg-white px-2.5 py-1 inline-block uppercase mb-4">
        SHOWROOM EN VIVO — 08 RUBROS ARGENTINOS
      </div>
      <h3 class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-[-0.04em] leading-none">
        DEMOS LISTAS PARA TU RUBRO
      </h3>
    </div>
    <a
      href="https://templates.nicoguzmandev.com"
      target="_blank"
      rel="noopener noreferrer"
      class="px-7 py-4 bg-[#002FA7] text-white hover:bg-white hover:text-[#0A0A0A] transition-colors duration-200 font-display text-xs font-extrabold uppercase tracking-[0.04em] flex items-center justify-between gap-8"
    >
      <span>ABRIR CATÁLOGO COMPLETO</span>
      <span class="font-mono-tech">[08]</span>
    </a>
  </div>

  <!-- Locomotive Interactive Index List -->
  <div class="divide-y-2 divide-[#0A0A0A]">
    {TEMPLATES.map((t) => (
      <a
        href={t.previewUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="grid grid-cols-1 lg:grid-cols-12 items-center p-6 md:px-10 md:py-7 bg-white text-[#0A0A0A] hover:bg-[#002FA7] hover:text-white transition-colors duration-200 group"
      >
        <div class="lg:col-span-1 font-display text-3xl md:text-4xl font-extrabold tracking-tighter text-[#002FA7] group-hover:text-white mb-2 lg:mb-0">
          {t.index}
        </div>

        <div class="lg:col-span-4 mb-2 lg:mb-0">
          <div class="font-display text-lg md:text-xl font-extrabold uppercase tracking-tight group-hover:translate-x-3 transition-transform duration-200">
            {t.name}
          </div>
          <div class="font-mono-tech text-[10px] font-bold tracking-[0.14em] text-[#52524E] group-hover:text-white/80 uppercase mt-0.5">
            {t.rubro}
          </div>
        </div>

        <div class="lg:col-span-4 text-xs text-[#52524E] group-hover:text-white/90 leading-relaxed mb-4 lg:mb-0 lg:pr-6">
          {t.desc}
        </div>

        <div class="lg:col-span-2 font-mono-tech text-[10px] font-bold tracking-[0.1em] uppercase text-[#52524E] group-hover:text-white/80 mb-3 lg:mb-0">
          {t.estructura}
        </div>

        <div class="lg:col-span-1 lg:text-right font-mono-tech text-xs font-bold uppercase tracking-wider">
          <span class="inline-block border-2 border-[#0A0A0A] group-hover:border-white px-3 py-1.5 group-hover:bg-white group-hover:text-[#002FA7] transition-colors">
            VER DEMO
          </span>
        </div>
      </a>
    ))}
  </div>
</div>

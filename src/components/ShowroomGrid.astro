---
import { ExternalLink, Sparkles, Smartphone, Check } from 'lucide-react';

const TEMPLATES = [
  {
    slug: 'barbershop',
    name: 'Vintage Barbershop',
    category: 'Belleza & Estilo',
    desc: 'Diseño oscuro premium para barberías y salones. Galería de cortes, lista de servicios y botón de reservas.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/barbershop',
    tag: 'Multipágina'
  },
  {
    slug: 'restaurant',
    name: 'Gourmet Bistro & Restaurant',
    category: 'Gastronomía',
    desc: 'Experiencia elegante para restaurantes y bares. Carta digital categorizada, fotos de platos y reserva de mesa.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/restaurant',
    tag: 'Multipágina'
  },
  {
    slug: 'coffee-shop',
    name: 'Artisan Coffee Roasters',
    category: 'Cafetería & Pastelería',
    desc: 'Estética cálida para cafeterías de especialidad. Origen de granos, menú dulce/salado y mapa de sucursales.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/coffee-shop',
    tag: 'Multipágina'
  },
  {
    slug: 'hardware-store',
    name: 'Industrial Hardware & Supplies',
    category: 'Ferreterías & Corralones',
    desc: 'Catálogo de herramientas y suministros industriales. Búsqueda de productos, pedidos por mayor y contacto.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/hardware-store',
    tag: 'Multipágina'
  },
  {
    slug: 'auto-repair',
    name: 'Precision Auto Service',
    category: 'Talleres & Mecánica',
    desc: 'Presencia confiable para talleres automotrices. Cotizador de mantenimiento, turnos mecánicos y emergencias.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/auto-repair',
    tag: 'Multipágina'
  },
  {
    slug: 'real-estate',
    name: 'Prime Real Estate & Living',
    category: 'Inmobiliarias & Propiedades',
    desc: 'Landing moderna para venta y alquiler. Fichas de propiedades, contacto directo de asesores y filtrado.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/real-estate',
    tag: 'Landing Page'
  },
  {
    slug: 'photography',
    name: 'Studio & Portrait Photography',
    category: 'Fotografía & Creativos',
    desc: 'Portfolio visual minimalista con galería en pantalla completa, paquetes de sesiones y formulario de reserva.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/photography',
    tag: 'Landing Page'
  },
  {
    slug: 'tattoo',
    name: 'Ink & Needle Tattoo Studio',
    category: 'Tatuajes & Arte Corporal',
    desc: 'Estilo neo-tradicional oscuro para estudios de tatuajes. Portafolios de artistas, flash art y cotización rápida.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/tattoo',
    tag: 'Landing Page'
  }
];
---

<div class="w-full">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-xs font-semibold text-sky-400 mb-3">
        <Sparkles className="w-3.5 h-3.5" />
        <span>8 Templates Listos para Producción</span>
      </div>
      <h3 class="text-2xl md:text-3xl font-bold text-white">
        Demos en Vivo por Industria
      </h3>
      <p class="text-sm text-zinc-400 mt-1 max-w-xl">
        Cada diseño está optimizado para convertir visitantes en clientes reales por WhatsApp o reservas directas.
      </p>
    </div>

    <a
      href="https://templates.nicoguzmandev.com"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold bg-sky-500/10 text-sky-400 hover:bg-sky-500/20 border border-sky-500/30 transition-colors"
    >
      <span>Abrir Showroom Completo</span>
      <ExternalLink className="w-3.5 h-3.5" />
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {TEMPLATES.map((t) => (
      <div class="glass-card rounded-2xl p-5 flex flex-col justify-between group hover:border-sky-500/40 transition-all">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-[11px] font-semibold text-sky-400 uppercase tracking-wider">
              {t.category}
            </span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700/60">
              {t.tag}
            </span>
          </div>

          <h4 class="font-bold text-base text-white group-hover:text-sky-300 transition-colors mb-2">
            {t.name}
          </h4>

          <p class="text-xs text-zinc-400 leading-relaxed mb-4">
            {t.desc}
          </p>
        </div>

        <div class="pt-3 border-t border-zinc-800/80 flex items-center justify-between">
          <a
            href={t.previewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-sky-400 hover:text-sky-300 inline-flex items-center gap-1.5 transition-colors"
          >
            <span>Probar Demo</span>
            <ExternalLink className="w-3.5 h-3.5" />
          </a>
          <span class="text-[11px] text-zinc-400 flex items-center gap-1">
            <Smartphone className="w-3 h-3 text-zinc-400" />
            100% Móvil
          </span>
        </div>
      </div>
    ))}
  </div>
</div>

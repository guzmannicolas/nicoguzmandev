---
const TEMPLATES = [
  {
    index: '01',
    slug: 'barbershop',
    name: 'Vintage Barbershop',
    vertical: 'Cuidado Personal & Estética',
    structure: 'Multipágina (4 Vistas)',
    desc: 'Editorial oscura para barberías y estudios de autor. Cuadro tarifario, galería de trabajos y módulo de reserva.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/barbershop'
  },
  {
    index: '02',
    slug: 'restaurant',
    name: 'Gourmet Bistro & Restaurant',
    vertical: 'Gastronomía & Hospitalidad',
    structure: 'Multipágina (3 Vistas)',
    desc: 'Composición tipográfica clásica para restaurantes y bares. Carta digital estructurada por tiempos, historia y reservas.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/restaurant'
  },
  {
    index: '03',
    slug: 'coffee-shop',
    name: 'Artisan Coffee Roasters',
    vertical: 'Cafetería de Especialidad',
    structure: 'Multipágina (4 Vistas)',
    desc: 'Diseño cálido para tostadores y cafeterías. Trazabilidad de granos, menú de barra, ubicaciones y horarios.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/coffee-shop'
  },
  {
    index: '04',
    slug: 'hardware-store',
    name: 'Industrial Hardware & Supplies',
    vertical: 'Ferretería Industrial & Insumos',
    structure: 'Multipágina (4 Vistas)',
    desc: 'Catálogo estructurado para provisión industrial y corralones. Líneas comerciales, solicitud de cotización mayorista.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/hardware-store'
  },
  {
    index: '05',
    slug: 'auto-repair',
    name: 'Precision Auto Service',
    vertical: 'Mecánica & Diagnóstico Automotriz',
    structure: 'Multipágina (4 Vistas)',
    desc: 'Plataforma técnica para talleres especializados. Detalle de servicios preventivos, diagnóstico electrónico y turnos.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/auto-repair'
  },
  {
    index: '06',
    slug: 'real-estate',
    name: 'Prime Real Estate & Living',
    vertical: 'Desarrollos & Comercialización Inmobiliaria',
    structure: 'Landing Page Ejecutiva',
    desc: 'Presentación de unidades residenciales y comerciales. Fichas técnicas de propiedades, tasaciones y contacto de asesores.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/real-estate'
  },
  {
    index: '07',
    slug: 'photography',
    name: 'Studio & Portrait Photography',
    vertical: 'Dirección de Arte & Fotografía',
    structure: 'Landing Page Editorial',
    desc: 'Porfolio visual de alto contraste con grilla fotográfica, especificación de paquetes comerciales y agenda de sesiones.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/photography'
  },
  {
    index: '08',
    slug: 'tattoo',
    name: 'Ink & Needle Tattoo Studio',
    vertical: 'Estudio de Tatuajes & Galería',
    structure: 'Landing Page de Autor',
    desc: 'Presentación de artistas residentes, catálogo de estilos, condiciones higiénicas y formulario de cotización de piezas.',
    previewUrl: 'https://templates.nicoguzmandev.com/preview/tattoo'
  }
];
---

<div class="w-full border border-[#222220] bg-[#0C0C0B]">
  <!-- Header Bar -->
  <div class="p-8 md:p-10 border-b border-[#222220] flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        CATÁLOGO DE ARQUITECTURAS BASE — 08 VERTICALES
      </div>
      <h3 class="text-2xl md:text-3xl font-normal tracking-[-0.02em] text-[#EDEDEC]">
        Matrices Comerciales en Producción
      </h3>
    </div>
    <a
      href="https://templates.nicoguzmandev.com"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-between gap-8 px-6 py-3.5 border border-[#363632] font-mono-tech text-[11px] tracking-[0.1em] text-[#EDEDEC] hover:bg-[#EDEDEC] hover:text-[#0C0C0B] transition-colors"
    >
      <span>ABRIR SHOWROOM COMPLETO</span>
      <span>/</span>
    </a>
  </div>

  <!-- 8-Cell Architectural Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 divide-y md:divide-y-0 border-b border-[#222220]">
    {TEMPLATES.slice(0, 4).map((t, i) => (
      <div class={`p-8 flex flex-col justify-between bg-[#0C0C0B] hover:bg-[#131311] transition-colors ${i < 3 ? 'lg:border-r border-[#222220]' : ''} ${i % 2 === 0 ? 'md:border-r border-[#222220]' : ''} border-b lg:border-b-0 border-[#222220]`}>
        <div>
          <div class="flex items-baseline justify-between border-b border-[#1C1C1A] pb-3 mb-5">
            <span class="font-mono-tech text-[11px] text-[#5E5D59]">[{t.index}]</span>
            <span class="font-mono-tech text-[10px] tracking-[0.08em] text-[#9A9994] uppercase">{t.structure}</span>
          </div>

          <div class="font-mono-tech text-[10px] tracking-[0.12em] text-[#5E5D59] uppercase mb-1.5">
            {t.vertical}
          </div>

          <h4 class="text-lg font-medium text-[#EDEDEC] tracking-[-0.01em] mb-3">
            {t.name}
          </h4>

          <p class="text-xs text-[#9A9994] leading-relaxed mb-8">
            {t.desc}
          </p>
        </div>

        <div class="pt-4 border-t border-[#1C1C1A]">
          <a
            href={t.previewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between font-mono-tech text-[11px] tracking-[0.1em] text-[#EDEDEC] hover:text-white group"
          >
            <span>EJECUTAR DEMO</span>
            <span class="text-[#5E5D59] group-hover:text-[#EDEDEC] transition-colors">—</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 divide-y md:divide-y-0">
    {TEMPLATES.slice(4, 8).map((t, i) => (
      <div class={`p-8 flex flex-col justify-between bg-[#0C0C0B] hover:bg-[#131311] transition-colors ${i < 3 ? 'lg:border-r border-[#222220]' : ''} ${i % 2 === 0 ? 'md:border-r border-[#222220]' : ''}`}>
        <div>
          <div class="flex items-baseline justify-between border-b border-[#1C1C1A] pb-3 mb-5">
            <span class="font-mono-tech text-[11px] text-[#5E5D59]">[{t.index}]</span>
            <span class="font-mono-tech text-[10px] tracking-[0.08em] text-[#9A9994] uppercase">{t.structure}</span>
          </div>

          <div class="font-mono-tech text-[10px] tracking-[0.12em] text-[#5E5D59] uppercase mb-1.5">
            {t.vertical}
          </div>

          <h4 class="text-lg font-medium text-[#EDEDEC] tracking-[-0.01em] mb-3">
            {t.name}
          </h4>

          <p class="text-xs text-[#9A9994] leading-relaxed mb-8">
            {t.desc}
          </p>
        </div>

        <div class="pt-4 border-t border-[#1C1C1A]">
          <a
            href={t.previewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between font-mono-tech text-[11px] tracking-[0.1em] text-[#EDEDEC] hover:text-white group"
          >
            <span>EJECUTAR DEMO</span>
            <span class="text-[#5E5D59] group-hover:text-[#EDEDEC] transition-colors">—</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</div>

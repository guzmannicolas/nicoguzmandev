---
// Advanced particles component with custom configuration and emitters support
interface Props {
  config?: {
    particleCount?: number;
    particleColor?: string;
    particleSize?: number;
    linkDistance?: number;
    moveSpeed?: number;
  };
}

const {
  config = {
    particleCount: 80,
    particleColor: "#ffffff",
    particleSize: 3,
    linkDistance: 150,
    moveSpeed: 2,
  },
} = Astro.props as Props;
---

<div id="tsparticles"></div>

<script define:vars={{ config }}>
  import { tsParticles } from "tsparticles-engine";
  import { loadSlim } from "tsparticles-slim";

  (async () => {
    try {
      await loadSlim(tsParticles);

      await tsParticles.load("tsparticles", {
        particles: {
          number: {
            value: config.particleCount || 80,
          },
          shape: {
            type: "polygon",
            polygon: {
              sides: 6, // Hexagon shape
            },
          },
          opacity: {
            value: 0.5,
            animation: {
              enable: true,
              minimumValue: 0.1,
              speed: 1,
              startValue: "max",
              destroy: "min",
            },
          },
          color: {
            value: config.particleColor || "#ffffff",
          },
          size: {
            value: config.particleSize || 3,
            random: {
              enable: true,
              minimumValue: 1,
            },
          },
          links: {
            enable: true,
            distance: config.linkDistance || 150,
            color: config.particleColor || "#ffffff",
            opacity: 0.4,
            width: 1,
          },
          move: {
            enable: true,
            speed: config.moveSpeed || 2,
            direction: "none",
            outModes: {
              default: "bounce",
            },
          },
          zIndex: {
            value: 1,
          },
        },
        interactivity: {
          events: {
            onHover: {
              enable: true,
              mode: "repulse",
            },
            onClick: {
              enable: true,
              mode: "push",
            },
            resize: {
              enable: true,
            },
          },
          modes: {
            repulse: {
              distance: 200,
              duration: 0.4,
            },
            push: {
              quantity: 4,
            },
          },
        },
        background: {
          color: "transparent",
        },
        fullScreen: {
          enable: true,
          zIndex: -1,
        },
        detectRetina: true,
        fpsLimit: 60,
      });
    } catch (error) {
      console.error("Error loading particles:", error);
    }
  })();
</script>

<style>
  #tsparticles {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }
</style>

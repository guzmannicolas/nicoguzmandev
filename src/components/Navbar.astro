---
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-[#0C0C0B]/95 backdrop-blur-sm border-b border-[#222220]">
  <div class="grid grid-cols-12 items-stretch min-h-[68px]">
    <!-- Brand Cell -->
    <div class="col-span-7 md:col-span-3 px-6 flex items-center border-r border-[#222220]">
      <a href="/" class="block group">
        <div class="text-sm font-medium tracking-[-0.02em] text-[#EDEDEC] group-hover:text-white transition-colors">
          NICOLÁS GUZMÁN
        </div>
        <div class="font-mono-tech text-[10px] tracking-[0.14em] text-[#5E5D59] uppercase mt-0.5">
          INGENIERÍA &amp; SISTEMAS
        </div>
      </a>
    </div>

    <!-- Navigation Cells (Desktop) -->
    <nav class="hidden md:grid md:col-span-6 grid-cols-4 divide-x divide-[#222220] border-r border-[#222220]">
      <a
        href="/webs"
        class={`px-4 flex flex-col justify-center hover:bg-[#131311] transition-colors ${pathname.startsWith('/webs') ? 'bg-[#131311]' : ''}`}
      >
        <span class="font-mono-tech text-[10px] text-[#5E5D59] tracking-[0.1em]">01</span>
        <span class="text-xs font-medium text-[#EDEDEC] mt-0.5">Presencia Web</span>
      </a>
      <a
        href="/automatizacion"
        class={`px-4 flex flex-col justify-center hover:bg-[#131311] transition-colors ${pathname.startsWith('/automatizacion') ? 'bg-[#131311]' : ''}`}
      >
        <span class="font-mono-tech text-[10px] text-[#5E5D59] tracking-[0.1em]">02</span>
        <span class="text-xs font-medium text-[#EDEDEC] mt-0.5">Automatización IA</span>
      </a>
      <a
        href="/erp"
        class={`px-4 flex flex-col justify-center hover:bg-[#131311] transition-colors ${pathname.startsWith('/erp') ? 'bg-[#131311]' : ''}`}
      >
        <span class="font-mono-tech text-[10px] text-[#5E5D59] tracking-[0.1em]">03</span>
        <span class="text-xs font-medium text-[#EDEDEC] mt-0.5">Sistemas &amp; ERP</span>
      </a>
      <a
        href="https://templates.nicoguzmandev.com"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 flex flex-col justify-center hover:bg-[#131311] transition-colors"
      >
        <span class="font-mono-tech text-[10px] text-[#5E5D59] tracking-[0.1em]">CATÁLOGO</span>
        <span class="text-xs font-medium text-[#9A9994] hover:text-[#EDEDEC] mt-0.5">Catálogo Web</span>
      </a>
    </nav>

    <!-- Action Cell -->
    <div class="col-span-5 md:col-span-3 flex items-stretch justify-end">
      <a
        href="/contacto"
        class="w-full px-6 flex items-center justify-between text-xs font-medium tracking-[0.02em] bg-[#EDEDEC] text-[#0C0C0B] hover:bg-white transition-colors"
      >
        <span>INICIAR CONSULTA</span>
        <span class="font-mono-tech text-[11px]">—</span>
      </a>
    </div>
  </div>

  <!-- Mobile Sub-navigation Bar -->
  <nav class="grid grid-cols-4 md:hidden divide-x divide-[#222220] border-t border-[#222220] bg-[#0C0C0B]">
    <a href="/webs" class="py-2.5 px-2 text-center text-[11px] font-medium text-[#9A9994] hover:text-[#EDEDEC]">
      01. Webs
    </a>
    <a href="/automatizacion" class="py-2.5 px-2 text-center text-[11px] font-medium text-[#9A9994] hover:text-[#EDEDEC]">
      02. IA
    </a>
    <a href="/erp" class="py-2.5 px-2 text-center text-[11px] font-medium text-[#9A9994] hover:text-[#EDEDEC]">
      03. ERP
    </a>
    <a href="https://templates.nicoguzmandev.com" target="_blank" rel="noopener noreferrer" class="py-2.5 px-2 text-center text-[11px] font-medium text-[#9A9994] hover:text-[#EDEDEC]">
      Catálogo
    </a>
  </nav>
</header>

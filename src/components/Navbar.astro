---
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-[#F7F7F5] border-b-2 border-[#0A0A0A]">
  <div class="grid grid-cols-12 items-stretch min-h-[72px]">
    <!-- Brand Cell -->
    <div class="col-span-7 lg:col-span-3 px-6 md:px-8 flex items-center justify-between border-r-2 border-[#0A0A0A]">
      <a href="/" class="block group">
        <div class="font-display text-base md:text-lg font-extrabold tracking-[-0.04em] text-[#0A0A0A] uppercase leading-none">
          NICOLÁS GUZMÁN
        </div>
        <div class="font-mono-tech text-[10px] tracking-[0.14em] text-[#52524E] uppercase mt-1">
          BUENOS AIRES, ARGENTINA
        </div>
      </a>
    </div>

    <!-- Desktop Navigation Cells -->
    <nav class="hidden lg:grid lg:col-span-6 grid-cols-4 divide-x-2 divide-[#0A0A0A] border-r-2 border-[#0A0A0A]">
      <a
        href="/webs"
        class={`px-5 flex flex-col justify-center transition-colors duration-200 group ${
          pathname.startsWith('/webs')
            ? 'bg-[#002FA7] text-white'
            : 'bg-[#F7F7F5] text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white'
        }`}
      >
        <span class={`font-mono-tech text-[10px] font-bold tracking-[0.1em] ${pathname.startsWith('/webs') ? 'text-white/70' : 'text-[#002FA7] group-hover:text-white/70'}`}>
          (01)
        </span>
        <span class="font-display text-xs font-extrabold uppercase tracking-tight mt-0.5">
          Webs Locales
        </span>
      </a>

      <a
        href="/automatizacion"
        class={`px-5 flex flex-col justify-center transition-colors duration-200 group ${
          pathname.startsWith('/automatizacion')
            ? 'bg-[#002FA7] text-white'
            : 'bg-[#F7F7F5] text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white'
        }`}
      >
        <span class={`font-mono-tech text-[10px] font-bold tracking-[0.1em] ${pathname.startsWith('/automatizacion') ? 'text-white/70' : 'text-[#002FA7] group-hover:text-white/70'}`}>
          (02)
        </span>
        <span class="font-display text-xs font-extrabold uppercase tracking-tight mt-0.5">
          Automatización IA
        </span>
      </a>

      <a
        href="/erp"
        class={`px-5 flex flex-col justify-center transition-colors duration-200 group ${
          pathname.startsWith('/erp')
            ? 'bg-[#002FA7] text-white'
            : 'bg-[#F7F7F5] text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white'
        }`}
      >
        <span class={`font-mono-tech text-[10px] font-bold tracking-[0.1em] ${pathname.startsWith('/erp') ? 'text-white/70' : 'text-[#002FA7] group-hover:text-white/70'}`}>
          (03)
        </span>
        <span class="font-display text-xs font-extrabold uppercase tracking-tight mt-0.5">
          Sistemas &amp; ERP
        </span>
      </a>

      <a
        href="https://templates.nicoguzmandev.com"
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 flex flex-col justify-center bg-[#F7F7F5] text-[#0A0A0A] hover:bg-[#002FA7] hover:text-white transition-colors duration-200 group"
      >
        <span class="font-mono-tech text-[10px] font-bold tracking-[0.1em] text-[#002FA7] group-hover:text-white/80">
          (04)
        </span>
        <span class="font-display text-xs font-extrabold uppercase tracking-tight mt-0.5">
          Demos en Vivo
        </span>
      </a>
    </nav>

    <!-- Right Action Block -->
    <div class="col-span-5 lg:col-span-3 flex items-stretch">
      <a
        href="/contacto"
        class="w-full px-6 md:px-8 flex items-center justify-between bg-[#002FA7] text-white hover:bg-[#0A0A0A] transition-colors duration-200"
      >
        <span class="font-display text-xs font-extrabold uppercase tracking-[0.04em]">
          COTIZAR AHORA
        </span>
        <span class="font-mono-tech text-xs font-bold">[AR]</span>
      </a>
    </div>
  </div>

  <!-- Mobile Navigation Bar -->
  <nav class="grid grid-cols-4 lg:hidden divide-x-2 divide-[#0A0A0A] border-t-2 border-[#0A0A0A] bg-[#F7F7F5]">
    <a href="/webs" class="py-3 px-2 text-center font-mono-tech text-[10px] font-bold uppercase text-[#0A0A0A] hover:bg-[#002FA7] hover:text-white">
      01. Webs
    </a>
    <a href="/automatizacion" class="py-3 px-2 text-center font-mono-tech text-[10px] font-bold uppercase text-[#0A0A0A] hover:bg-[#002FA7] hover:text-white">
      02. IA Bot
    </a>
    <a href="/erp" class="py-3 px-2 text-center font-mono-tech text-[10px] font-bold uppercase text-[#0A0A0A] hover:bg-[#002FA7] hover:text-white">
      03. ERP
    </a>
    <a href="https://templates.nicoguzmandev.com" target="_blank" rel="noopener noreferrer" class="py-3 px-2 text-center font-mono-tech text-[10px] font-bold uppercase text-[#002FA7] hover:bg-[#002FA7] hover:text-white">
      04. Demos
    </a>
  </nav>
</header>

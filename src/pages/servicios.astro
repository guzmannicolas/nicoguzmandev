---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import es from '../i18n/es.json';

const lang = 'es';
---

<Layout title="Servicios - Nicolás Guzmán Dev" lang={lang}>
  <!-- Header -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="reveal text-4xl md:text-5xl font-bold text-white mb-4">
        {es.nav.servicios}
      </h1>
      <p class="reveal text-xl text-gray-400">
        Soluciones completas para tu negocio
      </p>
    </div>
  </section>

  <!-- Diseño -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="text-4xl">
              <Icon icon="design" />
            </div>
            <h2 class="text-3xl font-bold text-white">{es.services.design.title}</h2>
          </div>
          <p class="text-gray-400 text-lg mb-6">
            Creo diseños web modernos y responsivos que no solo se ven bien, sino que convierten visitantes en clientes. Cada proyecto es personalizado para reflejar tu marca y alcanzar tus objetivos de negocio.
          </p>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Diseño responsivo y mobile-first</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">UX/UI optimizado</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Prototipos interactivos</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Accesibilidad web</span></li>
          </ul>
        </div>
        <div class="reveal bg-secondary border border-gray-700 rounded-lg h-96 flex items-center justify-center">
          <div class="text-8xl">
            <Icon icon="design" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Programación -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <div class="reveal bg-secondary border border-gray-700 rounded-lg h-96 flex items-center justify-center">
          <div class="text-8xl">
            <Icon icon="development" />
          </div>
        </div>
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="text-4xl">
              <Icon icon="development" />
            </div>
            <h2 class="text-3xl font-bold text-white">{es.services.development.title}</h2>
          </div>
          <p class="text-gray-400 text-lg mb-6">
            Desarrollo de aplicaciones web y móviles escalables usando las últimas tecnologías. Desde startups hasta empresas grandes, creo soluciones que crecen con tu negocio.
          </p>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">React, Next.js, Astro</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Node.js, Python, Bases de datos</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">API RESTful y GraphQL</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Implementación y DevOps</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Automatización -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="text-4xl">
              <Icon icon="automation" />
            </div>
            <h2 class="text-3xl font-bold text-white">{es.services.automation.title}</h2>
          </div>
          <p class="text-gray-400 text-lg mb-6">
            Automatizo procesos repetitivos para que tu equipo se enfoque en lo importante. Desde integraciones con herramientas terceras hasta automatización de flujos complejos.
          </p>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Integración de APIs</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Bots y webhooks</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Flujos de trabajo automáticos</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Reportes automáticos</span></li>
          </ul>
        </div>
        <div class="reveal bg-secondary border border-gray-700 rounded-lg h-96 flex items-center justify-center">
          <div class="text-8xl">
            <Icon icon="automation" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ERP -->
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <div class="reveal bg-secondary border border-gray-700 rounded-lg h-96 flex items-center justify-center">
          <div class="text-8xl">
            <Icon icon="erp" />
          </div>
        </div>
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="text-4xl">
              <Icon icon="erp" />
            </div>
            <h2 class="text-3xl font-bold text-white">{es.services.erp.title}</h2>
          </div>
          <p class="text-gray-400 text-lg mb-6">
            Sistemas ERP personalizados diseñados específicamente para tu negocio. Integro todos tus procesos en una plataforma única y fácil de usar.
          </p>
          <ul class="space-y-3 text-gray-300">
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Gestión de inventario</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Facturación y contabilidad</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Gestión de proyectos</span></li>
            <li class="flex items-center"><Icon icon="check" /><span class="ml-3">Reportes y análisis</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="reveal text-4xl font-bold text-white mb-4">
        ¿Necesitas una solución personalizada?
      </h2>
      <p class="reveal text-gray-400 text-lg mb-8">
        Contáctame para discutir cómo puedo ayudarte
      </p>
      <a
        href="/contacto"
        class="reveal inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold"
      >
        Agendar consulta
      </a>
    </div>
  </section>
</Layout>

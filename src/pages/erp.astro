---
import Layout from '../layouts/Layout.astro';
import ErpMetricsSimulator from '../components/ErpMetricsSimulator.tsx';
import ContactForm from '../components/ContactForm.tsx';
import { Layers, Store, ShieldCheck, Database, BarChart3, Users, ArrowRight, MessageSquare } from 'lucide-react';
---

<Layout
  title="Consultoría & Sistemas ERP a Medida para Pymes — Nicolás Guzmán"
  description="Sistemas de gestión, control de stock y facturación personalizados para pymes con múltiples sucursales. Sin licencias abusivas por usuario."
>
  <!-- Hero -->
  <section class="pt-24 pb-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-500/10 border border-purple-500/20 text-xs font-semibold text-purple-400 mb-6">
        <Layers className="w-4 h-4" />
        <span>Rama 3 • Consultoría de Software & ERP</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight mb-6 leading-tight">
        Control Total de tus Sucursales y Stock <span class="text-gradient-purple">Sin Planillas de Excel</span>
      </h1>

      <p class="text-lg text-zinc-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Cuando una pyme crece, el desorden operativo y las herramientas genéricas frenan la rentabilidad. Desarrollamos software de gestión a la medida exacta de tus procesos, centralizando inventario, pedidos y finanzas.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="#dashboard"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-purple-600 text-white hover:bg-purple-500 transition-colors shadow-lg shadow-purple-600/20"
        >
          <span>Ver Demo de Panel Operativo</span>
          <ArrowRight className="w-4 h-4" />
        </a>

        <a
          href="https://wa.me/5491100000000?text=Hola%20Nico!%20Tengo%20una%20pyme%20y%20necesito%20consultor%C3%ADa%20para%20un%20sistema%20ERP%20a%20medida."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-sm bg-zinc-900 text-zinc-200 hover:text-white border border-zinc-700/80 transition-colors"
        >
          <MessageSquare className="w-4 h-4" />
          <span>Agendar Diagnóstico Técnico</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Live ERP Dashboard Demo -->
  <section id="dashboard" class="py-16 px-4 border-t border-white/5 bg-zinc-950/40">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Simulador de Control Multi-Sucursal</h2>
        <p class="text-xs text-zinc-400">Navegá entre sucursales y observá cómo se consolida la información en tiempo real:</p>
      </div>

      <ErpMetricsSimulator client:load />
    </div>
  </section>

  <!-- Core Modules -->
  <section class="py-20 px-4 border-t border-white/5">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-white mb-3">Módulos Desarrollados a Medida</h2>
        <p class="text-xs text-zinc-400">Cada módulo se programa adaptado al flujo real de trabajo de tu equipo:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-purple-500/15 text-purple-400 flex items-center justify-center mb-4">
            <Store className="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Control Multi-Sucursal</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Transferencias de mercadería entre depósitos y locales con comprobantes auditados y trazabilidad punto a punto.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-purple-500/15 text-purple-400 flex items-center justify-center mb-4">
            <Database className="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Inventario en Tiempo Real</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Alertas automáticas de quiebre de stock, conteo por código de barras y valorización monetaria continua.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-purple-500/15 text-purple-400 flex items-center justify-center mb-4">
            <Users className="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Permisos & Roles</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Los cajeros solo ven su terminal, los encargados su local y la dirección el consolidado financiero general.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-white/10">
          <div class="w-10 h-10 rounded-xl bg-purple-500/15 text-purple-400 flex items-center justify-center mb-4">
            <BarChart3 className="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-white mb-2">Dashboards Ejecutivos</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Reportes claros de margen, productos más vendidos, rendimiento por sucursal y exportación a Excel/PDF.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-20 px-4 border-t border-white/5 bg-zinc-950/60">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <h2 class="text-3xl font-extrabold text-white mb-3">Planifiquemos la Arquitectura de tu Empresa</h2>
      <p class="text-sm text-zinc-400">Agendá una sesión de relevamiento técnico para diseñar el alcance exacto de tu software.</p>
    </div>
    <ContactForm client:load />
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ErpMetricsSimulator from '../components/ErpMetricsSimulator.tsx';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="(03) Consultoría & Sistemas ERP a Medida para Pymes en Argentina — Nicolás Guzmán"
  description="Sistemas de gestión, control de stock multi-sucursal, cajas y facturación ARCA/AFIP hechos a medida para pymes en Argentina. Sin pagar licencias por empleado."
>
  <!-- Hero Split -->
  <section class="border-b-2 border-[#0A0A0A] grid grid-cols-1 lg:grid-cols-12">
    <div class="lg:col-span-7 p-8 sm:p-12 md:p-20 bg-white border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0A0A]">
      <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-white bg-[#002FA7] px-3 py-1 inline-block uppercase mb-6">
        RAMA 03 — PYMES, DISTRIBUIDORAS Y MULTI-SUCURSAL
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-extrabold uppercase tracking-[-0.045em] leading-[0.94] text-[#0A0A0A] mb-8">
        CONTROLÁ TU STOCK Y TUS SUCURSALES SIN PLANILLAS DE EXCEL.
      </h1>
      <p class="text-sm sm:text-base text-[#52524E] leading-relaxed max-w-2xl mb-10 font-medium">
        Cuando tu empresa suma sucursales, vendedores o un depósito aparte, las planillas de Excel se rompen y los sistemas enlatados no se adaptan a tu forma real de trabajar. Construimos tu propio sistema ERP a medida: stock en vivo, cierres de caja, cuentas corrientes y facturación, sin cobrarte licencias mensuales por usuario.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#tablero"
          class="px-8 py-4 bg-[#002FA7] text-white hover:bg-[#0A0A0A] transition-colors font-display text-xs font-extrabold uppercase tracking-[0.04em] flex items-center justify-between gap-8"
        >
          <span>VER TABLERO INTERACTIVO</span>
          <span class="font-mono-tech">[DEMO]</span>
        </a>
        <a
          href="https://wa.me/5491100000000?text=Hola%20Nico!%20Tengo%20una%20pyme%20y%20quiero%20consultar%20por%20un%20sistema%20ERP%20a%20medida%20(Rama%2003)."
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border-2 border-[#0A0A0A] text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors font-mono-tech text-xs font-bold uppercase flex items-center justify-between gap-8"
        >
          <span>AGENDAR LLAMADA TÉCNICA</span>
          <span>—</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 bg-[#002FA7] text-white p-8 sm:p-12 md:p-16 flex flex-col justify-between">
      <div class="font-display text-7xl sm:text-8xl font-extrabold tracking-tighter leading-none">
        03.
      </div>
      <div class="space-y-6 pt-8 border-t border-white/25">
        <div class="font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-white/80">
          VENTAJAS PARA TU EMPRESA
        </div>
        <div class="space-y-3 text-xs font-mono-tech">
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>CANTIDAD DE EMPLEADOS</span>
            <span class="font-bold">ILIMITADOS ($0 POR USUARIO)</span>
          </div>
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>SUCURSALES Y DEPÓSITOS</span>
            <span class="font-bold">CONECTADOS EN VIVO</span>
          </div>
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>FACTURACIÓN ARGENTINA</span>
            <span class="font-bold">INTEGRACIÓN ARCA / AFIP</span>
          </div>
          <div class="flex justify-between pb-1">
            <span>PROPIEDAD DEL SISTEMA</span>
            <span class="font-bold">100% DE TU PYME</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Modules Grid -->
  <section class="border-b-2 border-[#0A0A0A] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 divide-y-2 md:divide-y-0 md:divide-x-2 divide-[#0A0A0A] bg-[#F7F7F5]">
    <div class="p-8 sm:p-10">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">01.</div>
      <h2 class="font-display text-base font-extrabold uppercase tracking-tight mb-2.5">
        STOCK MULTI-SUCURSAL
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        Controlá mercadería entre el galpón y cada local con remitos internos, código de barras y avisos antes de quedarte sin productos clave.
      </p>
    </div>

    <div class="p-8 sm:p-10">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">02.</div>
      <h2 class="font-display text-base font-extrabold uppercase tracking-tight mb-2.5">
        CAJAS Y CUENTAS CORRIENTES
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        Seguimiento exacto de cobros en efectivo, transferencia, cheques y tarjetas, más saldos de clientes mayoristas y proveedores.
      </p>
    </div>

    <div class="p-8 sm:p-10">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">03.</div>
      <h2 class="font-display text-base font-extrabold uppercase tracking-tight mb-2.5">
        PERMISOS POR EMPLEADO
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        El cajero solo ve su mostrador, el encargado su sucursal y vos tenés el control completo con historial de quién modificó cada dato.
      </p>
    </div>

    <div class="p-8 sm:p-10">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">04.</div>
      <h2 class="font-display text-base font-extrabold uppercase tracking-tight mb-2.5">
        REPORTES PARA EL DUEÑO
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        Mirás desde el celular cuánto vendió cada local hoy, cuál es tu ganancia real limpia y qué mercadería tiene mayor rotación.
      </p>
    </div>
  </section>

  <!-- ERP Simulator -->
  <section id="tablero" class="p-6 sm:p-12 md:p-16 lg:p-20 border-b-2 border-[#0A0A0A] bg-white">
    <ErpMetricsSimulator client:load />
  </section>

  <!-- Contact Form -->
  <section class="p-6 sm:p-12 md:p-16 lg:p-20 bg-[#F7F7F5]">
    <div class="max-w-2xl mb-10">
      <div class="font-mono-tech text-xs font-bold tracking-[0.14em] text-[#002FA7] uppercase mb-2">
        ORDENÁ TU OPERACIÓN
      </div>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em]">
        PEDÍ UN RELEVAMIENTO PARA TU PYME
      </h2>
    </div>
    <ContactForm client:load />
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ErpMetricsSimulator from '../components/ErpMetricsSimulator.tsx';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="División 03: Consultoría & Sistemas ERP a Medida — Nicolás Guzmán"
  description="Ingeniería de software empresarial, control de inventario multi-sucursal y sistemas ERP personalizados para pequeñas y medianas empresas."
>
  <!-- Header Section -->
  <section class="border-b border-[#222220] p-8 sm:p-12 md:p-20">
    <div class="max-w-4xl">
      <div class="font-mono-tech text-[11px] tracking-[0.18em] text-[#5E5D59] uppercase mb-6">
        DIVISIÓN 03 / CONSULTORÍA DE SOFTWARE &amp; SISTEMAS ERP
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-normal tracking-[-0.03em] text-[#EDEDEC] leading-[1.08] mb-8">
        Control operativo centralizado para empresas que <span class="font-serif-editorial italic">superaron las planillas de cálculo</span>.
      </h1>
      <p class="text-base sm:text-lg text-[#9A9994] max-w-2xl leading-relaxed font-light mb-10">
        Desarrollamos sistemas de gestión propietarios para pymes con múltiples sucursales, depósitos o circuitos logísticos propios. Unifique inventario, facturación, cajas y reportes ejecutivos sin pagar cánones mensuales por cantidad de usuarios.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href="#tablero-erp"
          class="px-8 py-4 bg-[#EDEDEC] text-[#0C0C0B] text-xs font-medium tracking-[0.04em] hover:bg-white transition-colors flex items-center justify-between gap-8"
        >
          <span>INSPECCIONAR TABLERO OPERATIVO</span>
          <span class="font-mono-tech">—</span>
        </a>
        <a
          href="https://wa.me/5491100000000?text=Hola%20Nicol%C3%A1s.%20Necesito%20consultor%C3%ADa%20para%20un%20sistema%20ERP%20a%20medida%20(Divisi%C3%B3n%2003)."
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border border-[#363632] text-[#EDEDEC] font-mono-tech text-[11px] tracking-[0.08em] hover:bg-[#141412] transition-colors flex items-center justify-between gap-8"
        >
          <span>AGENDAR RELEVAMIENTO TÉCNICO</span>
          <span>/</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Core Modules 4-Column Grid -->
  <section class="border-b border-[#222220] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-[#222220]">
    <div class="p-8 sm:p-10">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        MÓDULO 01 — LOGÍSTICA
      </div>
      <h2 class="text-base font-medium text-[#EDEDEC] mb-2.5">
        Stock Multi-Sucursal
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Trazabilidad exacta de mercadería entre depósitos y locales, remitos internos auditados y alertas automáticas de punto de pedido.
      </p>
    </div>

    <div class="p-8 sm:p-10">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        MÓDULO 02 — TESORERÍA
      </div>
      <h2 class="text-base font-medium text-[#EDEDEC] mb-2.5">
        Facturación &amp; Cajas
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Consolidación de ventas de mostrador y mayoristas, cuentas corrientes de clientes/proveedores y conciliación diaria por terminal.
      </p>
    </div>

    <div class="p-8 sm:p-10">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        MÓDULO 03 — SEGURIDAD
      </div>
      <h2 class="text-base font-medium text-[#EDEDEC] mb-2.5">
        Roles y Auditoría
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Permisos granulares según jerarquía operativa. Cada modificación de stock o precio queda registrada con fecha, hora y usuario.
      </p>
    </div>

    <div class="p-8 sm:p-10">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        MÓDULO 04 — DIRECCIÓN
      </div>
      <h2 class="text-base font-medium text-[#EDEDEC] mb-2.5">
        Reportes Ejecutivos
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Métricas de rentabilidad por línea de producto, rotación de inventario y estados de resultados exportables en tiempo real.
      </p>
    </div>
  </section>

  <!-- Live ERP Ledger -->
  <section id="tablero-erp" class="p-8 sm:p-12 md:p-16 border-b border-[#222220]">
    <ErpMetricsSimulator client:load />
  </section>

  <!-- Briefing Form -->
  <section class="p-8 sm:p-12 md:p-16">
    <div class="max-w-2xl mb-10">
      <div class="font-mono-tech text-[10px] tracking-[0.18em] text-[#5E5D59] uppercase mb-2">
        ARQUITECTURA EMPRESARIAL
      </div>
      <h2 class="text-2xl sm:text-3xl font-normal tracking-[-0.02em] text-[#EDEDEC]">
        Solicitar Diagnóstico de Ingeniería ERP
      </h2>
    </div>
    <ContactForm client:load />
  </section>
</Layout>

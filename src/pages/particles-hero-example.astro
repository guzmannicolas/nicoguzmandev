---
// Real-world example: Hero section with particles background
import ParticlesBackground from "../components/ParticlesBackground.astro";

interface Props {
  title?: string;
}

const { title = "Welcome" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background-color: #0a0e27;
        color: #ffffff;
        overflow-x: hidden;
      }

      main {
        position: relative;
        z-index: 1;
        width: 100%;
      }

      /* Hero Section */
      .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
      }

      .hero-content {
        max-width: 800px;
        animation: fadeInUp 1s ease-out;
      }

      .hero-content h1 {
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, #ffffff 0%, #a0a0ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero-content p {
        font-size: 1.25rem;
        color: #d0d0ff;
        line-height: 1.6;
        margin-bottom: 2.5rem;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
      }

      .cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        padding: 0.875rem 2rem;
        border: 2px solid transparent;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
      }

      .btn-primary {
        background: linear-gradient(135deg, #a0a0ff 0%, #5050ff 100%);
        color: white;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(160, 160, 255, 0.4);
      }

      .btn-secondary {
        background: transparent;
        color: #a0a0ff;
        border-color: #a0a0ff;
      }

      .btn-secondary:hover {
        background: rgba(160, 160, 255, 0.1);
        box-shadow: 0 0 20px rgba(160, 160, 255, 0.2);
      }

      /* Features Section */
      .features {
        padding: 6rem 2rem;
        max-width: 1200px;
        margin: 0 auto;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(10px);
      }

      .features h2 {
        font-size: 2.5rem;
        margin-bottom: 3rem;
        text-align: center;
        background: linear-gradient(135deg, #ffffff 0%, #a0a0ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
      }

      .feature-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(160, 160, 255, 0.2);
        border-radius: 12px;
        transition: all 0.3s ease;
      }

      .feature-card:hover {
        background: rgba(160, 160, 255, 0.08);
        border-color: rgba(160, 160, 255, 0.4);
        transform: translateY(-5px);
      }

      .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
      }

      .feature-card h3 {
        color: #a0a0ff;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
      }

      .feature-card p {
        color: #b0b0d0;
        line-height: 1.6;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 768px) {
        .hero-content h1 {
          font-size: 2rem;
        }

        .hero-content p {
          font-size: 1rem;
        }

        .cta-buttons {
          gap: 0.75rem;
        }

        .btn {
          padding: 0.75rem 1.5rem;
          font-size: 0.9rem;
        }

        .features {
          padding: 3rem 1.5rem;
        }

        .features h2 {
          font-size: 1.75rem;
          margin-bottom: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Particles Background -->
    <ParticlesBackground />

    <!-- Main Content -->
    <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="hero-content">
          <h1>Next Generation Particle Effects</h1>
          <p>
            Interactive hexagon particles create stunning visual effects. Try
            hovering or clicking on the particles in the background.
          </p>
          <div class="cta-buttons">
            <button class="btn btn-primary">Get Started</button>
            <button class="btn btn-secondary">Learn More</button>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="features">
        <h2>Why Use Particles?</h2>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon">✨</div>
            <h3>Modern Design</h3>
            <p>
              Particle effects give your website a contemporary, cutting-edge
              aesthetic that impresses visitors.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Performance</h3>
            <p>
              Optimized with tsparticles-slim for minimal bundle size. Async
              loading ensures your site stays fast.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🎯</div>
            <h3>Customizable</h3>
            <p>
              Complete control over colors, particle count, speed, and
              interactivity. Tailor effects to your brand.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>Mobile Friendly</h3>
            <p>
              Responsive and fully functional on all devices. Automatically
              adjusts performance for mobile.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🎮</div>
            <h3>Interactive</h3>
            <p>
              Particles respond to user interactions. Hover to repulse, click to
              add new ones. Fully engaging.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🔧</div>
            <h3>Easy Setup</h3>
            <p>
              Simple Astro components ready to drop into your project. Full
              documentation and examples included.
            </p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

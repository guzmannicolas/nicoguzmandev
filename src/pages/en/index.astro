---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import en from '../../i18n/en.json';

const lang = 'en';
---

<Layout title="Nicolás Guzmán Dev - Home" lang={lang}>
  <!-- Hero Section -->
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-4 fade-in">
        {en.hero.title}
      </h1>
      <p class="text-xl md:text-2xl text-gray-400 mb-8 max-w-3xl mx-auto fade-in">
        {en.hero.subtitle}
      </p>
      <a
        href="/en/contact"
        class="inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold fade-in"
      >
        {en.hero.cta}
      </a>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl font-bold text-center text-white mb-4">
        {en.nav.servicios}
      </h2>
      <p class="text-center text-gray-400 mb-12 max-w-2xl mx-auto">
        I offer comprehensive technology solutions to transform your business
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <ServiceCard
          icon="🎨"
          title={en.services.design.title}
          description={en.services.design.description}
        />
        <ServiceCard
          icon="💻"
          title={en.services.development.title}
          description={en.services.development.description}
        />
        <ServiceCard
          icon="⚙️"
          title={en.services.automation.title}
          description={en.services.automation.description}
        />
        <ServiceCard
          icon="📊"
          title={en.services.erp.title}
          description={en.services.erp.description}
        />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">
        Ready to transform your business?
      </h2>
      <p class="text-gray-400 text-lg mb-8">
        Contact me today to discuss how we can work together
      </p>
      <a
        href="/en/contact"
        class="inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold"
      >
        Schedule a call
      </a>
    </div>
  </section>
</Layout>

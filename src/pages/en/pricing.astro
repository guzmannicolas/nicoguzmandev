---
import Layout from '../../layouts/Layout.astro';
import PricingCard from '../../components/PricingCard.astro';
import { pricingEn } from '../../data/pricing.js';

const lang = 'en';
---

<Layout title="Pricing - Nicolás Guzmán Dev" lang={lang} description="Pricing and packages for Design, Development, Automation and custom ERP services.">
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="reveal text-4xl md:text-5xl font-bold text-white mb-4">Pricing</h1>
      <p class="reveal text-xl text-gray-400 max-w-2xl mx-auto">
        Clear and transparent investment for each service. All prices in USD.
      </p>
    </div>
  </section>

  {pricingEn.map((service) => (
    <section class="py-12 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="reveal text-3xl font-bold text-white mb-2 text-center">
          {service.icon} {service.service}
        </h2>
        <p class="reveal text-gray-400 text-center mb-10">Choose the plan that best fits your project</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
          {service.plans.map((plan) => (
            <PricingCard
              service={service.service}
              iconType={service.service === 'Web Design' ? 'design' : service.service === 'Development' ? 'development' : service.service === 'Automation' ? 'automation' : 'erp'}
              plan={plan}
              contactLabel="Get a quote"
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="reveal text-3xl font-bold text-white mb-4">Project outside these ranges?</h2>
      <p class="reveal text-gray-400 text-lg mb-8">
        Contact me for a custom quote. No project is too big or too small.
      </p>
      <a
        href="/en/contact"
        class="reveal inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold"
      >
        Talk to Nicolás
      </a>
    </div>
  </section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import { testimonialsEn } from '../../data/testimonials.js';

const lang = 'en';
---

<Layout title="Testimonials - Nicolás Guzmán Dev" lang={lang} description="What clients say about Nicolás Guzmán Dev services.">
  <section class="py-16 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="reveal text-4xl md:text-5xl font-bold text-white mb-4">Testimonials</h1>
      <p class="reveal text-xl text-gray-400 max-w-2xl mx-auto">
        What clients who trusted me have to say
      </p>
    </div>
  </section>

  <section class="py-12 px-4">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonialsEn.map((t) => (
        <TestimonialCard {...t} />
      ))}
    </div>
  </section>

  <section class="py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="reveal text-3xl font-bold text-white mb-4">Want to be next?</h2>
      <p class="reveal text-gray-400 text-lg mb-8">
        Join the list of satisfied clients and transform your business.
      </p>
      <a
        href="/en/contact"
        class="reveal inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold"
      >
        Start a project
      </a>
    </div>
  </section>
</Layout>

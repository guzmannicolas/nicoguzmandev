---
// Example page demonstrating particles integration
import LayoutWithParticles from "../layouts/LayoutWithParticles.astro";
---

<LayoutWithParticles title="Particles Demo">
  <style>
    .container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      gap: 2rem;
    }

    h1 {
      font-size: 3rem;
      font-weight: 700;
      text-align: center;
      background: linear-gradient(135deg, #ffffff, #a0a0ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1.1rem;
      max-width: 600px;
      text-align: center;
      color: #d0d0ff;
      line-height: 1.6;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
      max-width: 1200px;
    }

    .feature-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 2rem;
      border-radius: 12px;
      transition: all 0.3s ease;
    }

    .feature-card:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-5px);
    }

    .feature-card h3 {
      color: #a0a0ff;
      margin-bottom: 1rem;
      font-size: 1.3rem;
    }

    .feature-card p {
      font-size: 0.95rem;
      color: #b0b0d0;
    }

    .cta-button {
      margin-top: 2rem;
      padding: 1rem 2.5rem;
      background: linear-gradient(135deg, #a0a0ff, #5050ff);
      border: none;
      color: white;
      font-size: 1rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .cta-button:hover {
      transform: scale(1.05);
      box-shadow: 0 0 30px rgba(160, 160, 255, 0.4);
    }

    .interactive-note {
      margin-top: 2rem;
      padding: 1.5rem;
      background: rgba(160, 160, 255, 0.1);
      border-left: 4px solid #a0a0ff;
      border-radius: 6px;
      color: #d0d0ff;
      text-align: center;
    }
  </style>

  <div class="container">
    <div>
      <h1>Hexagon Particles Background</h1>
      <p>
        Try hovering over or clicking on the particles. The background effect is
        completely interactive and doesn't block content.
      </p>
    </div>

    <div class="features">
      <div class="feature-card">
        <h3>Hexagon Shapes</h3>
        <p>
          Particles are rendered as hexagons, creating a modern geometric effect
          perfect for tech portfolios.
        </p>
      </div>

      <div class="feature-card">
        <h3>Interactive Physics</h3>
        <p>
          Hover to repulse particles, click to add new ones. The physics engine
          handles smooth animations.
        </p>
      </div>

      <div class="feature-card">
        <h3>Non-Blocking Content</h3>
        <p>
          Particles render behind content with pointer-events disabled, ensuring
          all interactive elements are accessible.
        </p>
      </div>

      <div class="feature-card">
        <h3>Fully Customizable</h3>
        <p>
          Adjust colors, particle count, speed, and more via component
          configuration props.
        </p>
      </div>

      <div class="feature-card">
        <h3>Performance Optimized</h3>
        <p>
          Uses tsparticles-slim for minimal bundle size. Async loading prevents
          blocking page render.
        </p>
      </div>

      <div class="feature-card">
        <h3>Emitter Support</h3>
        <p>
          Create particles spawning from specific points on your page for
          targeted visual effects.
        </p>
      </div>
    </div>

    <div class="interactive-note">
      <strong>Try interacting with the background:</strong> Hover or click to see
      particles respond!
    </div>

    <button class="cta-button">Get Started</button>
  </div>
</LayoutWithParticles>

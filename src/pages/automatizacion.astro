---
import Layout from '../layouts/Layout.astro';
import AiChatSimulator from '../components/AiChatSimulator.tsx';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="(02) Automatización & Bots de WhatsApp con IA en Argentina — Nicolás Guzmán"
  description="Agentes de Inteligencia Artificial en WhatsApp que atienden las 24hs, pasan presupuestos y agendan turnos solos en Google Calendar para negocios en Argentina."
>
  <!-- Hero Split -->
  <section class="border-b-2 border-[#0A0A0A] grid grid-cols-1 lg:grid-cols-12">
    <div class="lg:col-span-7 p-8 sm:p-12 md:p-20 bg-white border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0A0A]">
      <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-white bg-[#002FA7] px-3 py-1 inline-block uppercase mb-6">
        RAMA 02 — ATENCIÓN Y TURNOS AUTOMÁTICOS 24/7
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-extrabold uppercase tracking-[-0.045em] leading-[0.94] text-[#0A0A0A] mb-8">
        NO PIERDAS MÁS CLIENTES POR RESPONDER TARDE.
      </h1>
      <p class="text-sm sm:text-base text-[#52524E] leading-relaxed max-w-2xl mb-10 font-medium">
        Si ya tenés Instagram activo o una web pero tardás horas en contestar mensajes, la gente se enfría y compra en otro lado. Te instalamos un asistente con Inteligencia Artificial en tu WhatsApp que responde al instante, informa tus precios y anota turnos solo en Google Calendar.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#simulador"
          class="px-8 py-4 bg-[#002FA7] text-white hover:bg-[#0A0A0A] transition-colors font-display text-xs font-extrabold uppercase tracking-[0.04em] flex items-center justify-between gap-8"
        >
          <span>PROBAR EL SIMULADOR AHORA</span>
          <span class="font-mono-tech">[EN VIVO]</span>
        </a>
        <a
          href="https://wa.me/5491100000000?text=Hola%20Nico!%20Quiero%20automatizar%20el%20WhatsApp%20y%20turnos%20de%20mi%20negocio%20(Rama%2002)."
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border-2 border-[#0A0A0A] text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors font-mono-tech text-xs font-bold uppercase flex items-center justify-between gap-8"
        >
          <span>CONSULTAR POR WHATSAPP</span>
          <span>—</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 bg-[#0A0A0A] text-white p-8 sm:p-12 md:p-16 flex flex-col justify-between">
      <div class="font-display text-7xl sm:text-8xl font-extrabold tracking-tighter leading-none text-[#002FA7]">
        02.
      </div>
      <div class="space-y-6 pt-8 border-t border-white/20">
        <div class="font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-white/70">
          QUÉ HACE EL SISTEMA SOLO
        </div>
        <div class="space-y-3 text-xs font-mono-tech">
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>VELOCIDAD DE RESPUESTA</span>
            <span class="font-bold">MENOS DE 1 SEGUNDO</span>
          </div>
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>AGENDA CONECTADA</span>
            <span class="font-bold">GOOGLE CALENDAR</span>
          </div>
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>ENTIENDE AUDIOS Y TEXTO</span>
            <span class="font-bold">SÍ (LENGUAJE NATURAL)</span>
          </div>
          <div class="flex justify-between pb-1">
            <span>PUESTA EN MARCHA</span>
            <span class="font-bold">5 A 7 DÍAS HÁBILES</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Pillars -->
  <section class="border-b-2 border-[#0A0A0A] grid grid-cols-1 md:grid-cols-3 divide-y-2 md:divide-y-0 md:divide-x-2 divide-[#0A0A0A] bg-[#F7F7F5]">
    <div class="p-8 sm:p-12">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">01.</div>
      <h2 class="font-display text-lg font-extrabold uppercase tracking-tight mb-3">
        NO ES UN BOT TONTO DE "MARCÁ 1 O 2"
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        La gente odia los menús automáticos viejos. Nuestro agente conversa de forma natural, entiende lo que el cliente pregunta (incluso si manda un audio) y le responde con los datos reales de tu negocio.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">02.</div>
      <h2 class="font-display text-lg font-extrabold uppercase tracking-tight mb-3">
        TURNERO AUTOMÁTICO SIN SUPERPOSICIONES
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        El agente mira qué huecos tenés libres en tu Google Calendar, le ofrece las opciones al cliente, registra la cita y le manda un recordatorio antes del turno para que no falte.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">03.</div>
      <h2 class="font-display text-lg font-extrabold uppercase tracking-tight mb-3">
        TE DERIVA SOLO LO QUE VALE LA PENA
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        El bot filtra el 90% de las preguntas repetitivas ("¿cuánto sale?", "¿dónde están?", "¿tienen turno?"). Cuando aparece un caso especial, te avisa para que intervengas vos.
      </p>
    </div>
  </section>

  <!-- Simulator -->
  <section id="simulador" class="p-6 sm:p-12 md:p-16 lg:p-20 border-b-2 border-[#0A0A0A] bg-white">
    <AiChatSimulator client:load />
  </section>

  <!-- Contact Form -->
  <section class="p-6 sm:p-12 md:p-16 lg:p-20 bg-[#F7F7F5]">
    <div class="max-w-2xl mb-10">
      <div class="font-mono-tech text-xs font-bold tracking-[0.14em] text-[#002FA7] uppercase mb-2">
        AUTOMATIZÁ TU ATENCIÓN
      </div>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em]">
        IMPLEMENTÁ TU AGENTE IA EN 5 DÍAS
      </h2>
    </div>
    <ContactForm client:load />
  </section>
</Layout>

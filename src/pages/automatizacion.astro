---
import Layout from '../layouts/Layout.astro';
import AiChatSimulator from '../components/AiChatSimulator.tsx';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="División 02: Automatización & Agentes IA — Nicolás Guzmán"
  description="Sistemas conversacionales de inteligencia artificial y gestión autónoma de turnos sobre WhatsApp Business API sincronizados con Google Calendar."
>
  <!-- Header Section -->
  <section class="border-b border-[#222220] p-8 sm:p-12 md:p-20">
    <div class="max-w-4xl">
      <div class="font-mono-tech text-[11px] tracking-[0.18em] text-[#5E5D59] uppercase mb-6">
        DIVISIÓN 02 / AUTOMATIZACIÓN COMERCIAL &amp; AGENTES IA
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-normal tracking-[-0.03em] text-[#EDEDEC] leading-[1.08] mb-8">
        Elimine la pérdida de clientes por <span class="font-serif-editorial italic">demoras en la atención</span> y gestión manual de turnos.
      </h1>
      <p class="text-base sm:text-lg text-[#9A9994] max-w-2xl leading-relaxed font-light mb-10">
        Implementamos agentes de inteligencia artificial entrenados sobre el conocimiento real de su negocio. Operan las 24 horas en WhatsApp, responden con lenguaje natural, cotizan servicios y registran turnos en Google Calendar sin intervención humana.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href="#protocolo"
          class="px-8 py-4 bg-[#EDEDEC] text-[#0C0C0B] text-xs font-medium tracking-[0.04em] hover:bg-white transition-colors flex items-center justify-between gap-8"
        >
          <span>EXAMINAR PROTOCOLO EN VIVO</span>
          <span class="font-mono-tech">—</span>
        </a>
        <a
          href="https://wa.me/5491100000000?text=Hola%20Nicol%C3%A1s.%20Quiero%20evaluar%20la%20automatizaci%C3%B3n%20con%20IA%20para%20mi%20negocio%20(Divisi%C3%B3n%2002)."
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border border-[#363632] text-[#EDEDEC] font-mono-tech text-[11px] tracking-[0.08em] hover:bg-[#141412] transition-colors flex items-center justify-between gap-8"
        >
          <span>COORDINAR DIAGNÓSTICO POR WHATSAPP</span>
          <span>/</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Technical Pillars -->
  <section class="border-b border-[#222220] grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#222220]">
    <div class="p-8 sm:p-12">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        CAPACIDAD 01 — TIEMPO REAL
      </div>
      <h2 class="text-lg font-medium text-[#EDEDEC] mb-3">
        Respuesta en Menos de un Segundo
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        El 78% de los cierres comerciales se producen con el primer proveedor que contesta. Su canal de WhatsApp responde al instante las 24 horas, incluidos fines de semana y feriados.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        CAPACIDAD 02 — SINCRONIZACIÓN
      </div>
      <h2 class="text-lg font-medium text-[#EDEDEC] mb-3">
        Integración Nativa con Google Calendar
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        El agente consulta los espacios disponibles de cada profesional o sucursal, reserva el turno sin superposiciones y emite recordatorios automáticos para reducir el ausentismo.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        CAPACIDAD 03 — CRITERIO COMERCIAL
      </div>
      <h2 class="text-lg font-medium text-[#EDEDEC] mb-3">
        Entrenamiento Contextual y Derivación
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Sin menús numéricos rígidos. Comprende audios y textos libres aplicando sus tarifas y políticas reales, y transfiere la conversación a un humano cuando detecta casos especiales.
      </p>
    </div>
  </section>

  <!-- Live Simulator -->
  <section id="protocolo" class="p-8 sm:p-12 md:p-16 border-b border-[#222220]">
    <AiChatSimulator client:load />
  </section>

  <!-- Briefing Form -->
  <section class="p-8 sm:p-12 md:p-16">
    <div class="max-w-2xl mb-10">
      <div class="font-mono-tech text-[10px] tracking-[0.18em] text-[#5E5D59] uppercase mb-2">
        INICIO DE IMPLEMENTACIÓN
      </div>
      <h2 class="text-2xl sm:text-3xl font-normal tracking-[-0.02em] text-[#EDEDEC]">
        Solicitar Relevamiento de Automatización
      </h2>
    </div>
    <ContactForm client:load />
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import es from '../i18n/es.json';

const lang = 'es';
---

<Layout title="Nicolás Guzmán Dev - Inicio" lang={lang}>
  <!-- Hero Section -->
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-4 fade-in">
        {es.hero.title}
      </h1>
      <p class="text-xl md:text-2xl text-gray-400 mb-8 max-w-3xl mx-auto fade-in">
        {es.hero.subtitle}
      </p>
      <a
        href="/contacto"
        class="inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold fade-in"
      >
        {es.hero.cta}
      </a>
    </div>
  </section>

  <!-- Servicios Section -->
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-4xl font-bold text-center text-white mb-4">
        {es.nav.servicios}
      </h2>
      <p class="text-center text-gray-400 mb-12 max-w-2xl mx-auto">
        Ofrezco soluciones tecnológicas completas para transformar tu negocio
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <ServiceCard
          icon="🎨"
          title={es.services.design.title}
          description={es.services.design.description}
        />
        <ServiceCard
          icon="💻"
          title={es.services.development.title}
          description={es.services.development.description}
        />
        <ServiceCard
          icon="⚙️"
          title={es.services.automation.title}
          description={es.services.automation.description}
        />
        <ServiceCard
          icon="📊"
          title={es.services.erp.title}
          description={es.services.erp.description}
        />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">
        ¿Listo para transformar tu negocio?
      </h2>
      <p class="text-gray-400 text-lg mb-8">
        Contactame hoy para discutir cómo podemos trabajar juntos
      </p>
      <a
        href="/contacto"
        class="inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold"
      >
        Agendar una llamada
      </a>
    </div>
  </section>
</Layout>

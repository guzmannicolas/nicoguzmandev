---
import Layout from '../layouts/Layout.astro';
import DiagnosticSelector from '../components/DiagnosticSelector.tsx';
import AiChatSimulator from '../components/AiChatSimulator.tsx';
import ErpMetricsSimulator from '../components/ErpMetricsSimulator.tsx';
import ShowroomGrid from '../components/ShowroomGrid.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="NICOLÁS GUZMÁN — Webs para Locales, Automatización IA & Sistemas ERP en Argentina"
  description="Estudio de ingeniería web y software en Argentina. Webs para comercios listas en 48hs, bots de IA y turneros en WhatsApp 24/7, y sistemas ERP a medida para pymes."
>
  <!-- HERO SECTION: LOCOMOTIVE / CONCEPT B MONUMENTAL SPLIT -->
  <section class="border-b-2 border-[#0A0A0A]">
    <div class="grid grid-cols-1 lg:grid-cols-12">
      <!-- Left Cobalt Statement Block (5 Cols) -->
      <div class="lg:col-span-5 bg-[#002FA7] text-white p-8 sm:p-12 md:p-16 flex flex-col justify-between border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0A0A] min-h-[540px]">
        <div>
          <div class="flex items-center justify-between border-b border-white/25 pb-4 mb-10">
            <span class="font-mono-tech text-xs font-bold tracking-[0.14em] uppercase">
              INGENIERÍA COMERCIAL
            </span>
            <span class="font-mono-tech text-xs font-bold bg-white text-[#002FA7] px-2 py-0.5">
              EDICIÓN 2026
            </span>
          </div>

          <h1 class="font-display text-5xl sm:text-6xl xl:text-7xl font-extrabold uppercase tracking-[-0.05em] leading-[0.92] mb-8">
            MENOS HUMO.<br />
            MÁS VENTAS.<br />
            MÁS SISTEMA.
          </h1>
        </div>

        <div class="space-y-6 pt-8 border-t border-white/25">
          <p class="text-sm sm:text-base text-white/90 leading-relaxed font-medium">
            Tres soluciones tecnológicas concretas para tres etapas de negocio en Argentina: aparecer primero en Google, responder al instante en WhatsApp y controlar el stock de tus sucursales.
          </p>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="#diagnostico"
              class="flex-1 py-4 px-6 bg-white text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors duration-200 font-display text-xs font-extrabold uppercase tracking-[0.04em] flex items-center justify-between"
            >
              <span>ELEGIR MI ETAPA</span>
              <span class="font-mono-tech">[01-03]</span>
            </a>
            <a
              href="https://templates.nicoguzmandev.com"
              target="_blank"
              rel="noopener noreferrer"
              class="py-4 px-6 border-2 border-white text-white hover:bg-white hover:text-[#002FA7] transition-colors duration-200 font-mono-tech text-xs font-bold uppercase flex items-center justify-between gap-4"
            >
              <span>VER 8 DEMOS</span>
              <span>/</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Brutalist Index Table (7 Cols) -->
      <div class="lg:col-span-7 bg-white flex flex-col justify-between divide-y-2 divide-[#0A0A0A]">
        <!-- Top Metadata Bar -->
        <div class="p-6 md:px-12 bg-[#F7F7F5] flex flex-wrap items-center justify-between gap-4">
          <span class="font-mono-tech text-xs font-bold tracking-[0.14em] text-[#0A0A0A] uppercase">
            ÍNDICE DE SOLUCIONES COMERCIALES
          </span>
          <span class="font-mono-tech text-xs font-bold text-[#002FA7]">
            TRATO DIRECTO CON EL PROGRAMADOR
          </span>
        </div>

        <!-- Row 01 -->
        <a
          href="/webs"
          class="p-8 md:p-12 bg-white text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors duration-200 group flex-1 flex flex-col justify-center"
        >
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
            <div class="md:col-span-3 font-display text-6xl md:text-7xl font-extrabold tracking-tighter leading-none text-[#002FA7] group-hover:text-white">
              01
            </div>
            <div class="md:col-span-9">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="font-display text-2xl sm:text-3xl font-extrabold uppercase tracking-tight group-hover:translate-x-2 transition-transform">
                  WEBS PARA LOCALES
                </h2>
                <span class="font-mono-tech text-[11px] font-bold bg-[#002FA7] text-white px-2.5 py-1">
                  ENTREGA 48 A 72 HS
                </span>
              </div>
              <p class="text-xs sm:text-sm text-[#52524E] group-hover:text-white/80 leading-relaxed mb-4">
                Para negocios sin web o que hoy solo tienen Instagram. Sitios rápidos con tu catálogo, precios, Google Maps y pedidos directos a tu WhatsApp.
              </p>
              <span class="font-mono-tech text-xs font-bold uppercase tracking-wider underline underline-offset-4">
                VER ESPECIFICACIÓN Y 8 DEMOS EN VIVO —
              </span>
            </div>
          </div>
        </a>

        <!-- Row 02 -->
        <a
          href="/automatizacion"
          class="p-8 md:p-12 bg-white text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors duration-200 group flex-1 flex flex-col justify-center"
        >
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
            <div class="md:col-span-3 font-display text-6xl md:text-7xl font-extrabold tracking-tighter leading-none text-[#002FA7] group-hover:text-white">
              02
            </div>
            <div class="md:col-span-9">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="font-display text-2xl sm:text-3xl font-extrabold uppercase tracking-tight group-hover:translate-x-2 transition-transform">
                  AUTOMATIZACIÓN &amp; IA
                </h2>
                <span class="font-mono-tech text-[11px] font-bold bg-[#0A0A0A] text-white group-hover:bg-[#002FA7] px-2.5 py-1">
                  WHATSAPP 24/7
                </span>
              </div>
              <p class="text-xs sm:text-sm text-[#52524E] group-hover:text-white/80 leading-relaxed mb-4">
                Para negocios que SÍ tienen redes o web activa pero pierden ventas por tardar en responder o no tener turnero automático en Google Calendar.
              </p>
              <span class="font-mono-tech text-xs font-bold uppercase tracking-wider underline underline-offset-4">
                PROBAR SIMULADOR DE WHATSAPP IA —
              </span>
            </div>
          </div>
        </a>

        <!-- Row 03 -->
        <a
          href="/erp"
          class="p-8 md:p-12 bg-white text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors duration-200 group flex-1 flex flex-col justify-center"
        >
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
            <div class="md:col-span-3 font-display text-6xl md:text-7xl font-extrabold tracking-tighter leading-none text-[#002FA7] group-hover:text-white">
              03
            </div>
            <div class="md:col-span-9">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="font-display text-2xl sm:text-3xl font-extrabold uppercase tracking-tight group-hover:translate-x-2 transition-transform">
                  CONSULTORÍA &amp; ERP
                </h2>
                <span class="font-mono-tech text-[11px] font-bold bg-[#0A0A0A] text-white group-hover:bg-[#002FA7] px-2.5 py-1">
                  PYMES &amp; SUCURSALES
                </span>
              </div>
              <p class="text-xs sm:text-sm text-[#52524E] group-hover:text-white/80 leading-relaxed mb-4">
                Para pymes con sucursales o depósito que necesitan controlar stock, cajas y facturación en vivo sin depender de planillas de Excel que se rompen.
              </p>
              <span class="font-mono-tech text-xs font-bold uppercase tracking-wider underline underline-offset-4">
                VER TABLERO MULTI-SUCURSAL —
              </span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- KINETIC LOCOMOTIVE MARQUEE BAND -->
  <div class="bg-[#0A0A0A] text-white border-b-2 border-[#0A0A0A] py-4 overflow-hidden select-none">
    <div class="animate-marquee font-mono-tech text-xs font-bold uppercase tracking-[0.2em] flex items-center gap-10">
      <span>(01) WEBS PARA COMERCIOS EN 48HS</span>
      <span class="text-[#002FA7]">///</span>
      <span>(02) BOTS DE WHATSAPP CON IA &amp; TURNEROS 24/7</span>
      <span class="text-[#002FA7]">///</span>
      <span>(03) SISTEMAS DE STOCK Y GESTIÓN ERP PARA PYMES</span>
      <span class="text-[#002FA7]">///</span>
      <span>100% CÓDIGO PROPIO SIN ALQUILERES FORZADOS</span>
      <span class="text-[#002FA7]">///</span>
      <span>(01) WEBS PARA COMERCIOS EN 48HS</span>
      <span class="text-[#002FA7]">///</span>
      <span>(02) BOTS DE WHATSAPP CON IA &amp; TURNEROS 24/7</span>
      <span class="text-[#002FA7]">///</span>
      <span>(03) SISTEMAS DE STOCK Y GESTIÓN ERP PARA PYMES</span>
      <span class="text-[#002FA7]">///</span>
      <span>100% CÓDIGO PROPIO SIN ALQUILERES FORZADOS</span>
    </div>
  </div>

  <!-- SECTION 01: INTERACTIVE DIAGNOSTIC MATRIX -->
  <section id="diagnostico" class="p-6 sm:p-12 md:p-16 lg:p-20 border-b-2 border-[#0A0A0A] bg-[#F7F7F5] scroll-mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12">
      <div class="lg:col-span-8">
        <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-[#002FA7] uppercase mb-3">
          (01) — DIAGNÓSTICO INTERACTIVO
        </div>
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-[-0.04em] leading-[0.95] text-[#0A0A0A]">
          ¿EN QUÉ ETAPA ESTÁ TU NEGOCIO HOY?
        </h2>
      </div>
      <div class="lg:col-span-4">
        <p class="text-xs sm:text-sm text-[#52524E] leading-relaxed font-medium">
          Seleccioná una de las 3 ramas abajo para ver qué problema resuelve, qué te entregamos exactamente y en cuánto tiempo está funcionando.
        </p>
      </div>
    </div>

    <DiagnosticSelector client:load />
  </section>

  <!-- SECTION 02: RAMA 01 — WEBS PARA LOCALES & SHOWROOM -->
  <section id="webs" class="p-6 sm:p-12 md:p-16 lg:p-20 border-b-2 border-[#0A0A0A] bg-white">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12">
      <div class="lg:col-span-8">
        <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-[#002FA7] uppercase mb-3">
          (02) — RAMA 01: PRESENCIA WEB PARA LOCALES
        </div>
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-[-0.04em] leading-[0.95] text-[#0A0A0A]">
          TU NEGOCIO EN GOOGLE CON CATÁLOGO PROPIO.
        </h2>
      </div>
      <div class="lg:col-span-4">
        <p class="text-xs sm:text-sm text-[#52524E] leading-relaxed font-medium">
          Hacé clic en cualquiera de nuestros 8 modelos comerciales para probar cómo se ve y funciona en computadora, tablet o celular.
        </p>
      </div>
    </div>

    <ShowroomGrid />
  </section>

  <!-- SECTION 03: RAMA 02 — AUTOMATIZACIÓN & IA WHATSAPP -->
  <section id="simulador-ia" class="p-6 sm:p-12 md:p-16 lg:p-20 border-b-2 border-[#0A0A0A] bg-[#F7F7F5] scroll-mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12">
      <div class="lg:col-span-8">
        <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-[#002FA7] uppercase mb-3">
          (03) — RAMA 02: AUTOMATIZACIÓN &amp; TURNOS CON IA
        </div>
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-[-0.04em] leading-[0.95] text-[#0A0A0A]">
          DEJÁ DE PERDER VENTAS POR CONTESTAR TARDE.
        </h2>
      </div>
      <div class="lg:col-span-4">
        <p class="text-xs sm:text-sm text-[#52524E] leading-relaxed font-medium">
          Probá nuestro simulador: elegí un caso real a la izquierda y mirá cómo el agente de IA atiende al cliente y bloquea el turno en Google Calendar sin que toques el teléfono.
        </p>
      </div>
    </div>

    <AiChatSimulator client:load />
  </section>

  <!-- SECTION 04: RAMA 03 — CONSULTORÍA & SISTEMAS ERP -->
  <section id="tablero-erp" class="p-6 sm:p-12 md:p-16 lg:p-20 border-b-2 border-[#0A0A0A] bg-white scroll-mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12">
      <div class="lg:col-span-8">
        <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-[#002FA7] uppercase mb-3">
          (04) — RAMA 03: CONSULTORÍA &amp; SISTEMAS ERP
        </div>
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-[-0.04em] leading-[0.95] text-[#0A0A0A]">
          CONTROL TOTAL DE TUS SUCURSALES Y STOCK.
        </h2>
      </div>
      <div class="lg:col-span-4">
        <p class="text-xs sm:text-sm text-[#52524E] leading-relaxed font-medium">
          Para pymes que crecieron y necesitan conectar depósito, mostrador, cajas y facturación en un solo sistema hecho a medida.
        </p>
      </div>
    </div>

    <ErpMetricsSimulator client:load />
  </section>

  <!-- SECTION 05: POR QUÉ TRABAJAR DIRECTO CONMIGO -->
  <section class="border-b-2 border-[#0A0A0A] bg-[#0A0A0A] text-white">
    <div class="p-8 sm:p-12 md:p-16 border-b border-white/20 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-white bg-[#002FA7] px-2.5 py-1 inline-block uppercase mb-4">
          (05) — DIFERENCIA REAL
        </div>
        <h2 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em] leading-none">
          POR QUÉ ELEGIR ESTE ESTUDIO
        </h2>
      </div>
      <div class="font-mono-tech text-xs text-white/70">
        INGENIERÍA DE SOFTWARE EN ARGENTINA
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/20">
      <div class="p-8 sm:p-12 hover:bg-[#002FA7] transition-colors duration-200">
        <div class="font-display text-5xl font-extrabold tracking-tighter mb-6">01.</div>
        <h3 class="font-display text-xl font-extrabold uppercase tracking-tight mb-3">
          HABLÁS DIRECTO CON QUIEN PROGRAMA
        </h3>
        <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
          Sin vendedores que prometen cosas imposibles ni cuentas que pasan de mano en mano. Hablás directamente conmigo, definimos el alcance y lo construyo.
        </p>
      </div>

      <div class="p-8 sm:p-12 hover:bg-[#002FA7] transition-colors duration-200">
        <div class="font-display text-5xl font-extrabold tracking-tighter mb-6">02.</div>
        <h3 class="font-display text-xl font-extrabold uppercase tracking-tight mb-3">
          SOS DUEÑO DEL 100% DE TU SISTEMA
        </h3>
        <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
          No te atamos con abonos mensuales abusivos ni te cobramos extra por agregar empleados en tu ERP. El código, el dominio y la base de datos son tuyos.
        </p>
      </div>

      <div class="p-8 sm:p-12 hover:bg-[#002FA7] transition-colors duration-200">
        <div class="font-display text-5xl font-extrabold tracking-tighter mb-6">03.</div>
        <h3 class="font-display text-xl font-extrabold uppercase tracking-tight mb-3">
          CRECÉ PASO A PASO SIN REHACER NADA
        </h3>
        <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
          Podés arrancar hoy con la web de tu local en 48hs, sumarle el bot de WhatsApp con IA el mes que viene y conectar tu stock después sobre la misma base.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 06: CONTACT & BRIEFING -->
  <section id="contacto" class="p-6 sm:p-12 md:p-16 lg:p-20 bg-[#F7F7F5] scroll-mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12">
      <div class="lg:col-span-8">
        <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-[#002FA7] uppercase mb-3">
          (06) — PRESUPUESTO SIN CARGO
        </div>
        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-[-0.04em] leading-[0.95] text-[#0A0A0A]">
          CONTAME QUÉ NECESITA TU NEGOCIO.
        </h2>
      </div>
      <div class="lg:col-span-4">
        <p class="text-xs sm:text-sm text-[#52524E] leading-relaxed font-medium">
          Elegí la rama que te interesa, dejame tus datos o mandame un WhatsApp directo y te paso una propuesta clara en el día.
        </p>
      </div>
    </div>

    <ContactForm client:load />
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { testimonials } from '../data/testimonials.js';
import es from '../i18n/es.json';

const lang = 'es';
---

<Layout title="Nicolás Guzmán Dev - Inicio" lang={lang}>
  <!-- Hero Section -->
  <section class="py-24 px-4">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="reveal text-5xl md:text-6xl font-bold text-white mb-4">
        {es.hero.title}
      </h1>
      <p class="reveal text-xl md:text-2xl text-gray-400 mb-8 max-w-3xl mx-auto">
        {es.hero.subtitle}
      </p>
      <div class="reveal flex flex-wrap justify-center gap-4">
        <a href="/contacto" class="inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold">
          {es.hero.cta}
        </a>
        <a href="/precios" class="inline-block border border-accent text-accent px-8 py-3 rounded-lg hover:bg-accent hover:text-white transition-colors text-lg font-semibold">
          Ver precios
        </a>
      </div>
    </div>
  </section>

  <!-- Servicios Section -->
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="reveal text-4xl font-bold text-center text-white mb-4">{es.nav.servicios}</h2>
      <p class="reveal text-center text-gray-400 mb-12 max-w-2xl mx-auto">
        Soluciones tecnológicas completas para transformar tu negocio
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <ServiceCard iconType="design" title={es.services.design.title} description={es.services.design.description} />
        <ServiceCard iconType="development" title={es.services.development.title} description={es.services.development.description} />
        <ServiceCard iconType="automation" title={es.services.automation.title} description={es.services.automation.description} />
        <ServiceCard iconType="erp" title={es.services.erp.title} description={es.services.erp.description} />
      </div>
    </div>
  </section>

  <!-- Testimonios Section -->
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <h2 class="reveal text-4xl font-bold text-center text-white mb-4">Lo que dicen mis clientes</h2>
      <p class="reveal text-center text-gray-400 mb-12 max-w-2xl mx-auto">
        Resultados reales para negocios reales
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.slice(0, 3).map((t) => (
          <TestimonialCard {...t} />
        ))}
      </div>
      <div class="reveal text-center mt-10">
        <a href="/testimonios" class="text-accent hover:underline font-semibold">
          Ver todos los testimonios →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="reveal text-4xl font-bold text-white mb-4">¿Listo para transformar tu negocio?</h2>
      <p class="reveal text-gray-400 text-lg mb-8">Contactame hoy y discutimos tu proyecto</p>
      <div class="reveal flex flex-wrap justify-center gap-4">
        <a href="/contacto" class="inline-block bg-accent text-white px-8 py-3 rounded-lg hover:bg-blue-600 transition-colors text-lg font-semibold">
          Agendar una llamada
        </a>
        <a href="/precios" class="inline-block border border-gray-600 text-gray-300 px-8 py-3 rounded-lg hover:border-accent hover:text-accent transition-colors text-lg font-semibold">
          Ver precios
        </a>
      </div>
    </div>
  </section>
</Layout>

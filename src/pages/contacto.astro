---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="Contacto & Presupuestos — Nicolás Guzmán (Argentina)"
  description="Contacto directo por WhatsApp o formulario para cotizar sitios web para locales, bots de IA y sistemas ERP a medida en Argentina."
>
  <section class="border-b-2 border-[#0A0A0A] grid grid-cols-1 lg:grid-cols-12">
    <div class="lg:col-span-8 p-8 sm:p-12 md:p-20 bg-white border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0A0A]">
      <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-white bg-[#002FA7] px-3 py-1 inline-block uppercase mb-6">
        CONTACTO DIRECTO — ARGENTINA
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-extrabold uppercase tracking-[-0.045em] leading-[0.94] text-[#0A0A0A] mb-6">
        HABLEMOS DE TU PROYECTO.
      </h1>
      <p class="text-sm sm:text-base text-[#52524E] leading-relaxed max-w-2xl font-medium">
        Completá los datos abajo o escribime directamente por WhatsApp. Te respondo yo mismo en menos de 2 horas con un diagnóstico claro y presupuesto cerrado.
      </p>
    </div>

    <div class="lg:col-span-4 bg-[#002FA7] text-white p-8 sm:p-12 flex flex-col justify-between">
      <div>
        <div class="font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-white/80 mb-3">
          CANAL MÁS RÁPIDO
        </div>
        <h2 class="font-display text-2xl font-extrabold uppercase tracking-tight mb-3">
          WHATSAPP DIRECTO
        </h2>
        <p class="text-xs text-white/90 leading-relaxed mb-8">
          Podés mandarme un texto o un audio contándome qué rubro tenés y qué necesitás resolver.
        </p>
      </div>
      <a
        href="https://wa.me/5491100000000?text=Hola%20Nico!%20Te%20escribo%20desde%20nicoguzmandev.com%20para%20pedirte%20presupuesto."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-5 px-6 bg-white text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors font-display text-xs font-extrabold uppercase tracking-[0.04em] flex items-center justify-between"
      >
        <span>ABRIR CHAT DE WHATSAPP</span>
        <span class="font-mono-tech">[AHORA]</span>
      </a>
    </div>
  </section>

  <section class="p-6 sm:p-12 md:p-16 lg:p-20 bg-[#F7F7F5]">
    <ContactForm client:load />
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import { MessageSquare, Mail, MapPin, Clock, ShieldCheck } from 'lucide-react';
---

<Layout
  title="Contacto & Diagnóstico — Nicolás Guzmán Dev"
  description="Contactate directamente con Nicolás Guzmán. Cotizaciones rápidas en menos de 2 horas para sitios web, agentes de IA y sistemas ERP."
>
  <section class="pt-24 pb-16 px-4">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900 border border-zinc-700 text-xs font-semibold text-zinc-300 mb-6">
        <span>Canal Directo de Asesoramiento</span>
      </div>

      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-4 leading-tight">
        Hablemos Sobre Tu Proyecto
      </h1>

      <p class="text-base text-zinc-400 max-w-xl mx-auto">
        Completá el formulario o escribime directamente por WhatsApp para coordinar una llamada de diagnóstico gratuita.
      </p>
    </div>

    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      <!-- Contact Info Cards -->
      <div class="lg:col-span-5 space-y-4">
        <div class="glass-card rounded-2xl p-6 border border-white/10 space-y-4">
          <div class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Canal Rápido</div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center shrink-0">
              <MessageSquare className="w-5 h-5" />
            </div>
            <div>
              <div class="font-bold text-sm text-white">WhatsApp Directo</div>
              <p class="text-xs text-zinc-400">Respuesta promedio en menos de 2 horas</p>
            </div>
          </div>
          <a
            href="https://wa.me/5491100000000?text=Hola%20Nico!%20Te%20escribo%20desde%20nicoguzmandev.com%20para%20hacerte%20una%20consulta."
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center py-2.5 px-4 rounded-xl text-xs font-semibold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 transition-colors"
          >
            Abrir Chat de WhatsApp
          </a>
        </div>

        <div class="glass-card rounded-2xl p-6 border border-white/10 space-y-3 text-xs text-zinc-300">
          <div class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Compromiso Profesional</div>
          <div class="flex items-start gap-2.5">
            <ShieldCheck className="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
            <span>Presupuestos claros y cerrados antes de iniciar, sin costos ocultos.</span>
          </div>
          <div class="flex items-start gap-2.5">
            <Clock className="w-4 h-4 text-sky-400 shrink-0 mt-0.5" />
            <span>Plazos de entrega estrictos: 48-72hs para webs, 5 días para bots IA.</span>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>
    </div>
  </section>
</Layout>

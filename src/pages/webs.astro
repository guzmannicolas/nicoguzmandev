---
import Layout from '../layouts/Layout.astro';
import ShowroomGrid from '../components/ShowroomGrid.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="(01) Webs para Locales y Comercios en Argentina — Nicolás Guzmán"
  description="Sitios web rápidos y profesionales para negocios y locales en Argentina. Catálogo, precios, ubicación en Google Maps y botón directo a WhatsApp en 48 a 72 horas."
>
  <!-- Hero Split -->
  <section class="border-b-2 border-[#0A0A0A] grid grid-cols-1 lg:grid-cols-12">
    <div class="lg:col-span-7 p-8 sm:p-12 md:p-20 bg-white border-b-2 lg:border-b-0 lg:border-r-2 border-[#0A0A0A]">
      <div class="font-mono-tech text-xs font-bold tracking-[0.16em] text-white bg-[#002FA7] px-3 py-1 inline-block uppercase mb-6">
        RAMA 01 — COMERCIOS, LOCALES Y PROFESIONALES
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-extrabold uppercase tracking-[-0.045em] leading-[0.94] text-[#0A0A0A] mb-8">
        TU NEGOCIO ABIERTO LAS 24 HORAS EN GOOGLE.
      </h1>
      <p class="text-sm sm:text-base text-[#52524E] leading-relaxed max-w-2xl mb-10 font-medium">
        Si un cliente busca tu rubro en tu barrio y no tenés web, le compra a otro. Te entregamos tu sitio listo para vender en 48 a 72 horas: carga al instante en el celular, muestra tu catálogo o carta de precios y te manda los pedidos directo a tu WhatsApp.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="https://templates.nicoguzmandev.com"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-[#002FA7] text-white hover:bg-[#0A0A0A] transition-colors font-display text-xs font-extrabold uppercase tracking-[0.04em] flex items-center justify-between gap-8"
        >
          <span>VER SHOWROOM DE 8 DEMOS</span>
          <span class="font-mono-tech">[EN VIVO]</span>
        </a>
        <a
          href="https://wa.me/5491100000000?text=Hola%20Nico!%20Quiero%20hacer%20la%20web%20para%20mi%20local%20(Rama%2001)."
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border-2 border-[#0A0A0A] text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white transition-colors font-mono-tech text-xs font-bold uppercase flex items-center justify-between gap-8"
        >
          <span>PEDIR PRESUPUESTO POR WHATSAPP</span>
          <span>—</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 bg-[#002FA7] text-white p-8 sm:p-12 md:p-16 flex flex-col justify-between">
      <div class="font-display text-7xl sm:text-8xl font-extrabold tracking-tighter leading-none">
        01.
      </div>
      <div class="space-y-6 pt-8 border-t border-white/25">
        <div class="font-mono-tech text-xs font-bold uppercase tracking-[0.14em] text-white/80">
          ESPECIFICACIÓN DE ENTREGA
        </div>
        <div class="space-y-3 text-xs font-mono-tech">
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>TIEMPO DE ARMADO</span>
            <span class="font-bold">48 A 72 HORAS</span>
          </div>
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>ADAPTADO A CELULARES</span>
            <span class="font-bold">100% RESPONSIVE</span>
          </div>
          <div class="flex justify-between border-b border-white/20 pb-2">
            <span>DOMINIO .COM / .COM.AR</span>
            <span class="font-bold">CONFIGURADO</span>
          </div>
          <div class="flex justify-between pb-1">
            <span>TECNOLOGÍA</span>
            <span class="font-bold">ASTRO 5 (SIN WORDPRESS)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Pillars Grid -->
  <section class="border-b-2 border-[#0A0A0A] grid grid-cols-1 md:grid-cols-3 divide-y-2 md:divide-y-0 md:divide-x-2 divide-[#0A0A0A] bg-[#F7F7F5]">
    <div class="p-8 sm:p-12">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">01.</div>
      <h2 class="font-display text-lg font-extrabold uppercase tracking-tight mb-3">
        CARGA EN MENOS DE 1 SEGUNDO
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        No usamos WordPress pesado ni plantillas que tardan en abrir. Tu cliente toca el link en su celular y ve tus productos o servicios al instante.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">02.</div>
      <h2 class="font-display text-lg font-extrabold uppercase tracking-tight mb-3">
        LISTA PARA GOOGLE MAPS Y SEO LOCAL
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        Dejamos configurada tu dirección, horarios, teléfono y palabras clave de tu rubro para que aparezcas cuando alguien busque en tu zona.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-display text-4xl font-extrabold text-[#002FA7] tracking-tighter mb-3">03.</div>
      <h2 class="font-display text-lg font-extrabold uppercase tracking-tight mb-3">
        PEDIDOS Y TURNOS DIRECTO A WHATSAPP
      </h2>
      <p class="text-xs text-[#52524E] leading-relaxed">
        Cada sección tiene llamadas a la acción claras para que el visitante te escriba con un toque sin tener que llenar formularios eternos.
      </p>
    </div>
  </section>

  <!-- Showroom Table -->
  <section class="p-6 sm:p-12 md:p-16 lg:p-20 border-b-2 border-[#0A0A0A] bg-white">
    <ShowroomGrid />
  </section>

  <!-- Contact Form -->
  <section class="p-6 sm:p-12 md:p-16 lg:p-20 bg-[#F7F7F5]">
    <div class="max-w-2xl mb-10">
      <div class="font-mono-tech text-xs font-bold tracking-[0.14em] text-[#002FA7] uppercase mb-2">
        ARRANCÁ HOY MISMO
      </div>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold uppercase tracking-[-0.04em]">
        PEDÍ LA WEB PARA TU LOCAL
      </h2>
    </div>
    <ContactForm client:load />
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ShowroomGrid from '../components/ShowroomGrid.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<Layout
  title="División 01: Presencia Web Comercial — Nicolás Guzmán"
  description="Infraestructura web de alta conversión para comercios, estudios y empresas de servicios. Desarrollo bajo arquitectura Astro con entrega en 48 a 72 horas."
>
  <!-- Header Section -->
  <section class="border-b border-[#222220] p-8 sm:p-12 md:p-20">
    <div class="max-w-4xl">
      <div class="font-mono-tech text-[11px] tracking-[0.18em] text-[#5E5D59] uppercase mb-6">
        DIVISIÓN 01 / INFRAESTRUCTURA WEB COMERCIAL
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-normal tracking-[-0.03em] text-[#EDEDEC] leading-[1.08] mb-8">
        Sitios web de respuesta inmediata para <span class="font-serif-editorial italic">captar la demanda local</span> en buscadores.
      </h1>
      <p class="text-base sm:text-lg text-[#9A9994] max-w-2xl leading-relaxed font-light mb-10">
        Diseñados específicamente para negocios físicos, gastronomía, comercios e industrias que necesitan profesionalizar su presencia digital, exhibir su catálogo con claridad y dirigir consultas calificadas a su WhatsApp comercial.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href="https://templates.nicoguzmandev.com"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-[#EDEDEC] text-[#0C0C0B] text-xs font-medium tracking-[0.04em] hover:bg-white transition-colors flex items-center justify-between gap-8"
        >
          <span>EXPLORAR LAS 08 DEMOS EN VIVO</span>
          <span class="font-mono-tech">—</span>
        </a>
        <a
          href="https://wa.me/5491100000000?text=Hola%20Nicol%C3%A1s.%20Me%20interesa%20desarrollar%20la%20web%20de%20mi%20negocio%20(Divisi%C3%B3n%2001)."
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border border-[#363632] text-[#EDEDEC] font-mono-tech text-[11px] tracking-[0.08em] hover:bg-[#141412] transition-colors flex items-center justify-between gap-8"
        >
          <span>SOLICITAR COTIZACIÓN POR WHATSAPP</span>
          <span>/</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Technical Specifications Grid -->
  <section class="border-b border-[#222220] grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#222220]">
    <div class="p-8 sm:p-12">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        ESPECIFICACIÓN 01 — RENDIMIENTO
      </div>
      <h2 class="text-lg font-medium text-[#EDEDEC] mb-3">
        Arquitectura Estática Sub-Segundo
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Prescindimos de gestores pesados como WordPress. Cada sitio se compila en código puro mediante Astro 5, logrando aperturas instantáneas incluso en conexiones móviles inestables.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        ESPECIFICACIÓN 02 — ADQUISICIÓN
      </div>
      <h2 class="text-lg font-medium text-[#EDEDEC] mb-3">
        Posicionamiento Orgánico Local
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Estructuración de metadatos semánticos, cartografía interactiva, horarios de atención y catálogo indexable para capturar búsquedas de cercanía en Google.
      </p>
    </div>

    <div class="p-8 sm:p-12">
      <div class="font-mono-tech text-[10px] tracking-[0.16em] text-[#5E5D59] uppercase mb-3">
        ESPECIFICACIÓN 03 — INFRAESTRUCTURA
      </div>
      <h2 class="text-lg font-medium text-[#EDEDEC] mb-3">
        Entrega Llave en Mano en 72 Horas
      </h2>
      <p class="text-xs text-[#9A9994] leading-relaxed">
        Incluye registro o delegación de dominio comercial propio (.com / .com.ar), certificados criptográficos SSL y despliegue sobre la red global de Vercel y Cloudflare.
      </p>
    </div>
  </section>

  <!-- Showroom Catalog -->
  <section class="p-8 sm:p-12 md:p-16 border-b border-[#222220]">
    <ShowroomGrid />
  </section>

  <!-- Briefing Form -->
  <section class="p-8 sm:p-12 md:p-16">
    <div class="max-w-2xl mb-10">
      <div class="font-mono-tech text-[10px] tracking-[0.18em] text-[#5E5D59] uppercase mb-2">
        INICIO DE PROYECTO
      </div>
      <h2 class="text-2xl sm:text-3xl font-normal tracking-[-0.02em] text-[#EDEDEC]">
        Solicitar Implementación Web
      </h2>
    </div>
    <ContactForm client:load />
  </section>
</Layout>

---
// Layout that includes particles background without blocking content
import ParticlesBackground from "../components/ParticlesBackground.astro";

interface Props {
  title?: string;
}

const { title = "Welcome" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #0a0e27;
        color: #ffffff;
        overflow-x: hidden;
      }

      /* Ensures content is above particles */
      main {
        position: relative;
        z-index: 1;
        pointer-events: auto;
      }
    </style>
  </head>
  <body>
    <!-- Particles rendered as background (z-index: -1) -->
    <ParticlesBackground />

    <!-- Main content is interactive and above particles -->
    <main>
      <slot />
    </main>
  </body>
</html>
